page {
  --blue: #1E40AF;
  --blue-700: #1C3AA0;
  --blue-600: #1D4ED8;
  --blue-500: #3B82F6;
  --blue-400: #60A5FA;
  --blue-100: #E0E7FF;
  --blue-50: #EEF2FF;
  --orange: #FF8C42;
  --orange-600: #E9721F;
  --orange-500: #F97316;
  --orange-400: #FB923C;
  --orange-100: #FFEDD5;
  --orange-50: #FFF7ED;
  --ink: #0F172A;
  --ink-light: #1E293B;
  --ink-lighter: #334155;
  --gray: #6B7280;
  --gray-400: #9CA3AF;
  --gray-light: #9CA3AF;
  --gray-lighter: #CBD5E1;
  --line: #E9EDF3;
  --bg: #F3F4F6;
  --bg-secondary: #EEF1F6;
  --card: #FFFFFF;
  --green: #16A34A;
  --green-100: #DCFCE7;
  --amber: #D97706;
  --amber-100: #FEF3C7;
  --gold: #D4AF37;
  --gold-100: #FFFBEB;
  --radius: 36rpx;
  --radius-sm: 24rpx;
  --radius-lg: 44rpx;
  --shadow: 0 6rpx 20rpx rgba(15,23,42,.08);
  --shadow-lg: 0 14rpx 40rpx rgba(30,64,175,.16);
  --shadow-xl: 0 20rpx 50rpx rgba(30,64,175,.2);
  --shadow-orange: 0 8rpx 24rpx rgba(255,140,66,.35);
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
  --transition-slow: 0.4s ease;
  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, navigator { box-sizing: border-box; margin: 0; padding: 0; }

.page-wrap { min-height: 100vh; padding-bottom: 40rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.flex1 { flex: 1; }
.muted { color: var(--gray); }
.center { text-align: center; }

.card {
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.sec-more { font-size: 24rpx; color: var(--blue); font-weight: 600; }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  height: 92rpx;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}
.btn::after { border: none; }
.btn-primary { 
  background: linear-gradient(135deg, var(--orange-600), var(--orange)); 
  color: #fff; 
  box-shadow: var(--shadow-orange);
}
.btn-primary:active { transform: scale(0.98); }
.btn-blue { 
  background: linear-gradient(135deg, var(--blue), var(--blue-600)); 
  color: #fff; 
  box-shadow: 0 8rpx 24rpx rgba(30,64,175,.3);
}
.btn-blue:active { transform: scale(0.98); }
.btn-ghost { 
  background: var(--blue-50); 
  color: var(--blue); 
  border: 2rpx solid var(--blue-100);
}
.btn-ghost:active { background: var(--blue-100); }
.btn-success { 
  background: linear-gradient(135deg, #059669, var(--green)); 
  color: #fff; 
}
.btn-outline { 
  background: transparent; 
  color: var(--blue); 
  border: 2rpx solid var(--blue); 
}
.btn-outline:active { background: var(--blue-50); }
.btn-block { width: 100%; }
.btn-small { height: 76rpx; font-size: 25rpx; }
.btn-icon { gap: 12rpx; }

.tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-weight: 700;
  line-height: 1.4;
}
.tag-primary  { background: rgba(30,64,175,0.08); color: var(--blue); }
.tag-secondary { background: rgba(255,140,66,0.08); color: var(--orange-600); }
.tag-success { background: rgba(22,163,74,0.08); color: var(--green); }
.tag-amber { background: rgba(217,119,6,0.08); color: var(--amber); }

.pill-switch {
  display: flex;
  background: var(--bg-secondary);
  border-radius: 28rpx;
  padding: 8rpx;
  margin: 20rpx 32rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,.04);
}
.pill {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--gray);
  transition: all var(--transition-normal);
  position: relative;
}
.pill.on { 
  background: linear-gradient(135deg, var(--blue), var(--blue-600)); 
  color: #fff; 
  box-shadow: 0 4rpx 16rpx rgba(30,64,175,.3);
}
.pill.orange.on { 
  background: linear-gradient(135deg, var(--orange-600), var(--orange)); 
  color: #fff; 
  box-shadow: 0 4rpx 16rpx rgba(255,140,66,.3);
}

.price { font-size: 24rpx; font-weight: 800; color: #fff; }
.price-lg { font-size: 40rpx; font-weight: 800; color: var(--orange-600); }
.price-unit { font-size: 18rpx; font-weight: 500; opacity: 0.8; }

.input {
  height: 88rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--ink);
  transition: all var(--transition-fast);
}
.input:focus { border-color: var(--blue); box-shadow: 0 0 0 6rpx rgba(30,64,175,.1); }
.input.ph { color: var(--gray-400); }

.searchbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 0 28rpx;
  color: var(--gray-400);
  font-size: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,23,42,.04);
  transition: all var(--transition-fast);
}
.searchbar:focus-within { border-color: var(--blue); box-shadow: 0 4rpx 20rpx rgba(30,64,175,.12); }

.status-dot {
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}
.st-active { background: #DCFCE7; color: var(--green); }
.st-pend { background: #FEF3C7; color: var(--amber); }
.st-lead { background: var(--blue-100); color: var(--blue); }
.st-done { background: #E2E8F0; color: #64748B; }

.badge-ar {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,.95);
  color: var(--blue);
  font-size: 20rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.1);
}

.price-tag {
  background: rgba(15,23,42,.75);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}

::-webkit-scrollbar { display: none; }

.capsule {
  display: flex;
  align-items: center;
  height: 60rpx;
  width: 156rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(0,0,0,.10);
  background: rgba(255,255,255,.55);
}
.capsule.dark {
  background: rgba(0,0,0,.22);
  border-color: rgba(255,255,255,.28);
}
.capsule .dot { flex: 1; display: flex; align-items: center; justify-content: center; }
.capsule .sep { width: 2rpx; height: 32rpx; background: rgba(0,0,0,.14); }
.capsule.dark .sep { background: rgba(255,255,255,.4); }

.sticky-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.95);
  backdrop-filter: blur(20px);
  border-top: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.04);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,23,42,.55);
  z-index: 1000;
  animation: fadeIn var(--transition-fast);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes scaleIn {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.gradient-text {
  background: linear-gradient(135deg, var(--blue), var(--orange));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.pattern-dots {
  background-image: radial-gradient(circle, rgba(30,64,175,.04) 1px, transparent 1px);
  background-size: 20rpx 20rpx;
}

.pattern-grid {
  background-image: 
    linear-gradient(rgba(30,64,175,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(30,64,175,.03) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
}

.glass {
  background: rgba(255,255,255,.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.empty-state {
  text-align: center;
  padding: 60rpx 40rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: var(--bg-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--gray);
  line-height: 1.6;
  margin-bottom: 32rpx;
}