# Server
PORT=3000
NODE_ENV=development

# Security - CRITICAL: CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-secret-string-32-characters-minimum
ADMIN_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=7d

# CORS - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://touristaar.com,https://www.touristaar.com

# Default admin (created on first run / seed). Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tourista2026

# WeChat Mini Program (fill from WeChat MP console)
WX_APPID=
WX_SECRET=

# WeChat Pay v3 (JSAPI) — real payments activate when all of the
# WXPAY_* vars below are set. Without them the backend runs in dev mode
# (orders confirm without real payment). Merchant platform: 账户中心 → API安全
WXPAY_MCHID=                          # 商户号, e.g. 1900000000
WXPAY_APPID=                          # optional, defaults to WX_APPID
WXPAY_SERIAL_NO=                      # 商户API证书序列号 (apiclient_cert.pem)
WXPAY_PRIVATE_KEY_PATH=               # path to apiclient_key.pem (商户私钥)
WXPAY_APIV3_KEY=                      # APIv3密钥 (exactly 32 characters)
WXPAY_NOTIFY_URL=                     # publicly reachable: https://your-domain/api/payment/notify
WXPAY_PLATFORM_PUBLIC_KEY_PATH=       # 微信支付公钥 OR 平台证书 (verifies notify signatures)
WXPAY_PUBLIC_KEY_ID=                  # optional: enforce the expected Wechatpay-Serial header value

# HTTPS (production only)
HTTPS_ENABLED=false
HTTPS_KEY_PATH=/path/to/private-key.pem
HTTPS_CERT_PATH=/path/to/certificate.pem
