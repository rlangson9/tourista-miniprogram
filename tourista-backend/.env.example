# Server
PORT=3000
NODE_ENV=development

# Security - CRITICAL: CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-secret-string-32-characters-minimum
ADMIN_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=7d

# CORS - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://touristaar.com,https://www.touristaar.com

# Default admin (created on first run / seed). Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tourista2026

# WeChat Mini Program (fill from WeChat MP console)
WX_APPID=
WX_SECRET=

# WeChat Pay (fill from WeChat merchant platform)
WXPAY_MCHID=
WXPAY_KEY=

# HTTPS (production only)
HTTPS_ENABLED=false
HTTPS_KEY_PATH=/path/to/private-key.pem
HTTPS_CERT_PATH=/path/to/certificate.pem
