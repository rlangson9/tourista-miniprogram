<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tourista AR — WeChat Mini Program Prototype</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --blue:#1E40AF; --blue-700:#1C3AA0; --blue-50:#EEF2FF; --blue-100:#E0E7FF;
    --orange:#FF8C42; --orange-600:#E9721F;
    --ink:#0F172A; --gray:#6B7280; --gray-400:#9CA3AF; --line:#E9EDF3;
    --bg:#F3F4F6; --card:#FFFFFF; --green:#16A34A; --amber:#D97706;
    --radius:18px; --shadow:0 6px 20px rgba(15,23,42,.08); --shadow-lg:0 14px 40px rgba(30,64,175,.16);
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-font-smoothing:antialiased}
  body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);line-height:1.5;padding:40px 24px 64px;
    background:radial-gradient(1200px 600px at 15% -10%,#E8EEFF 0%,transparent 55%),radial-gradient(1000px 500px at 100% 0%,#FFEEE0 0%,transparent 50%),#EDF0F5;}
  .page-head{max-width:1320px;margin:0 auto 30px;text-align:center}
  .brand-row{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:12px}
  .brand-mark{width:52px;height:52px;border-radius:15px;flex:none;background:linear-gradient(135deg,var(--blue),#3B5BDB 60%,var(--orange));display:grid;place-items:center;box-shadow:var(--shadow-lg)}
  .page-head h1{font-family:'Poppins',sans-serif;font-size:30px;letter-spacing:-.02em}
  .page-head .tag{color:var(--orange-600);font-weight:600;font-size:14px;margin-top:2px}
  .page-head p{color:var(--gray);max-width:660px;margin:12px auto 0;font-size:15px}
  .meta-chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px}
  .chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:12.5px;font-weight:600;color:var(--blue);box-shadow:0 2px 6px rgba(15,23,42,.04)}
  .chip.o{color:var(--orange-600)}
  .rail{max-width:1320px;margin:26px auto 0;text-align:left}
  .rail h2{font-family:'Poppins',sans-serif;font-size:16px;color:var(--ink);margin:0 0 2px;display:flex;align-items:center;gap:8px}
  .rail h2 .num{width:22px;height:22px;border-radius:6px;background:var(--blue);color:#fff;font-size:12px;display:grid;place-items:center}
  .rail p{color:var(--gray);font-size:13px;margin:0 0 14px}
  .gallery{display:flex;gap:26px;overflow-x:auto;padding:6px 2px 16px;scroll-snap-type:x proximity}
  .gallery::-webkit-scrollbar{height:8px}.gallery::-webkit-scrollbar-thumb{background:#cbd3e0;border-radius:4px}
  .frame-wrap{display:flex;flex-direction:column;align-items:center;gap:12px;width:322px;flex:none;scroll-snap-align:start}
  .caption{text-align:center}.caption b{display:block;font-family:'Poppins',sans-serif;font-size:14px}.caption span{font-size:12px;color:var(--gray)}

  .phone{width:322px;height:700px;border-radius:44px;background:#0B1020;padding:11px;box-shadow:var(--shadow-lg),0 0 0 2px #000 inset;position:relative;flex:none}
  .screen{width:100%;height:100%;border-radius:34px;overflow:hidden;background:var(--bg);position:relative;display:flex;flex-direction:column}
  .statusbar{height:34px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px 0 22px;font-size:13px;font-weight:700;color:var(--ink);z-index:5}
  .statusbar.on-color{color:#fff}
  .sb-right{display:flex;align-items:center;gap:6px}
  .navbar{height:44px;flex:none;display:flex;align-items:center;justify-content:center;position:relative;z-index:5;padding:0 16px}
  .navbar .title{font-size:16px;font-weight:600}
  .navbar.on-color .title{color:#fff}
  .capsule{position:absolute;right:14px;top:50%;transform:translateY(-50%);display:flex;align-items:center;height:30px;width:78px;border-radius:16px;border:1px solid rgba(0,0,0,.10);background:rgba(255,255,255,.55);backdrop-filter:blur(6px)}
  .capsule.dark{background:rgba(0,0,0,.22);border-color:rgba(255,255,255,.28)}
  .capsule .dot{flex:1;display:grid;place-items:center;height:100%}
  .capsule .sep{width:1px;height:16px;background:rgba(0,0,0,.14)}.capsule.dark .sep{background:rgba(255,255,255,.4)}
  .nav-back{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:30px;height:30px;display:grid;place-items:center;border-radius:50%}
  .body{flex:1;overflow:hidden;position:relative}
  .scroll{position:absolute;inset:0;overflow-y:auto;padding-bottom:16px}.scroll::-webkit-scrollbar{display:none}
  .pad{padding:0 16px}
  .tabbar{flex:none;height:60px;background:#fff;border-top:1px solid var(--line);display:flex;padding:6px 4px 0;z-index:5}
  .tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding-top:3px;cursor:pointer}
  .tab svg{width:22px;height:22px;stroke:#9AA3B0;fill:none}
  .tab span{font-size:9.5px;color:#9AA3B0;font-weight:500}
  .tab.active svg{stroke:var(--blue)}.tab.active span{color:var(--blue);font-weight:600}
  .home-ind{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);width:110px;height:4px;border-radius:3px;background:rgba(0,0,0,.18);z-index:6}
  .home-ind.light{background:rgba(255,255,255,.6)}

  .section-h{display:flex;align-items:center;justify-content:space-between;margin:16px 2px 9px}
  .section-h h3{font-size:14.5px;font-family:'Poppins',sans-serif}
  .section-h a{font-size:11.5px;color:var(--blue);font-weight:600}
  .searchbar{display:flex;align-items:center;gap:8px;height:38px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:0 12px;color:var(--gray-400);font-size:13px;box-shadow:0 2px 6px rgba(15,23,42,.04)}
  .searchbar svg{width:16px;height:16px;stroke:var(--gray-400);flex:none}
  .chips-row{display:flex;gap:7px;overflow-x:auto;padding:2px 0}.chips-row::-webkit-scrollbar{display:none}
  .pill{flex:none;font-size:12px;font-weight:600;padding:6px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--gray)}
  .pill.active{background:var(--blue);color:#fff;border-color:var(--blue)}
  .pill.o.active{background:var(--orange);border-color:var(--orange)}
  .btn{display:flex;align-items:center;justify-content:center;gap:7px;height:46px;border-radius:14px;font-size:14px;font-weight:700;border:none;width:100%;cursor:pointer}
  .btn-primary{background:var(--orange);color:#fff;box-shadow:0 8px 18px rgba(255,140,66,.35)}
  .btn-primary svg{width:17px;height:17px;stroke:#fff}
  .btn-blue{background:var(--blue);color:#fff}
  .btn-ghost{background:var(--blue-50);color:var(--blue)}.btn-ghost svg{width:17px;height:17px;stroke:var(--blue)}
  .badge-ar{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.9);color:var(--blue);font-size:10px;font-weight:700;padding:4px 8px;border-radius:999px;backdrop-filter:blur(4px)}
  .badge-ar svg{width:11px;height:11px;stroke:var(--orange-600)}
  .corridor{display:inline-flex;align-items:center;gap:5px;background:var(--blue-50);color:var(--blue);font-size:10.5px;font-weight:700;padding:4px 9px;border-radius:999px}
  .corridor svg{width:12px;height:12px;stroke:var(--orange-600)}

  /* dual mode cards */
  .dual{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
  .mode{border-radius:18px;padding:14px;min-height:118px;display:flex;flex-direction:column;justify-content:space-between;color:#fff;position:relative;overflow:hidden;box-shadow:var(--shadow)}
  .mode.a{background:linear-gradient(150deg,#1E40AF,#3B5BDB)}
  .mode.b{background:linear-gradient(150deg,#E9721F,#FF8C42)}
  .mode .ic{width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,.2);display:grid;place-items:center}
  .mode .ic svg{width:19px;height:19px;stroke:#fff;fill:none}
  .mode .mt{font-family:'Poppins',sans-serif;font-size:15px;line-height:1.2}
  .mode .ms{font-size:10.5px;opacity:.9;margin-top:2px}
  .mode .go{position:absolute;right:12px;bottom:12px}.mode .go svg{width:16px;height:16px;stroke:#fff}

  /* stats strip */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:#fff;border-radius:16px;box-shadow:var(--shadow);padding:14px 6px;margin-top:12px}
  .stat{text-align:center}.stat .v{font-family:'Poppins',sans-serif;font-size:17px;color:var(--blue)}.stat .v small{font-size:10px}
  .stat .l{font-size:9.5px;color:var(--gray);margin-top:2px;line-height:1.25}

  .dcard{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);margin-bottom:11px}
  .dcard .img{height:112px;position:relative;display:flex;align-items:flex-start;justify-content:space-between;padding:10px}
  .img.zim{background:linear-gradient(135deg,#059669,#0EA5E9)}
  .img.sa{background:linear-gradient(135deg,#F59E0B,#B91C1C)}
  .img.dual2{background:linear-gradient(135deg,#7c3aed,#1E40AF)}
  .img.expo{background:linear-gradient(135deg,#0EA5E9,#1E40AF)}
  .price-tag{position:absolute;right:10px;bottom:10px;background:rgba(15,23,42,.72);color:#fff;font-size:12px;font-weight:800;padding:5px 9px;border-radius:10px;backdrop-filter:blur(4px)}
  .price-tag small{font-weight:500;opacity:.8;font-size:9px}
  .dcard .info{padding:11px 12px 13px}
  .dcard .loc{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--gray);font-weight:600}
  .dcard .loc svg{width:12px;height:12px;stroke:var(--orange-600)}
  .dcard h4{font-size:14.5px;font-family:'Poppins',sans-serif;margin:3px 0 5px}
  .tagline{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
  .tg{font-size:9.5px;font-weight:700;color:var(--blue);background:var(--blue-50);padding:3px 7px;border-radius:6px}
  .dcard .foot{display:flex;align-items:center;justify-content:space-between}
  .seats{font-size:11px;color:var(--gray);font-weight:600}.seats b{color:var(--orange-600)}
  .book-btn{background:var(--orange);color:#fff;font-size:11.5px;font-weight:700;padding:7px 13px;border-radius:10px}
  .rating{display:flex;align-items:center;gap:3px;font-size:11px;font-weight:700}.rating svg{width:12px;height:12px;fill:var(--orange);stroke:var(--orange)}

  .lc{background:#fff;border-radius:16px;box-shadow:var(--shadow);padding:12px;margin-bottom:10px}
  .row{display:flex;align-items:center;gap:11px}
  .avatar{width:42px;height:42px;border-radius:12px;flex:none;display:grid;place-items:center;color:#fff;font-weight:700;font-size:14px;font-family:'Poppins',sans-serif}
  .avatar svg{width:20px;height:20px;stroke:#fff;fill:none}
  .grow{flex:1;min-width:0}.grow .t{font-size:13.5px;font-weight:600}.grow .s{font-size:11px;color:var(--gray);margin-top:2px}
  .status-dot{font-size:10px;font-weight:700;padding:4px 8px;border-radius:999px}
  .st-active{background:#DCFCE7;color:var(--green)}.st-pend{background:#FEF3C7;color:var(--amber)}.st-lead{background:var(--blue-100);color:var(--blue)}.st-done{background:#E2E8F0;color:#475569}

  /* success story card */
  .story{background:#fff;border-radius:16px;box-shadow:var(--shadow);overflow:hidden;margin-bottom:10px}
  .story .top{padding:12px}
  .story .cat{font-size:9.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--orange-600)}
  .story h4{font-size:13.5px;font-family:'Poppins',sans-serif;margin:4px 0 5px}
  .story p{font-size:11.5px;color:var(--gray);line-height:1.5}
  .story .bar{display:flex;align-items:center;gap:14px;padding:9px 12px;border-top:1px solid var(--line);color:var(--gray);font-size:11px}
  .story .bar .it{display:flex;align-items:center;gap:4px}.story .bar svg{width:13px;height:13px;stroke:var(--gray);fill:none}
  .story .bar .sp{margin-left:auto;color:var(--blue);font-weight:700}

  /* channels */
  .channels{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:6px}
  .ch{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:13px 8px;text-align:center}
  .ch .ci{width:38px;height:38px;border-radius:12px;margin:0 auto 7px;display:grid;place-items:center;background:var(--blue-50)}
  .ch .ci svg{width:20px;height:20px;stroke:var(--blue);fill:none}
  .ch .cl{font-size:10.5px;font-weight:600;line-height:1.25}

  /* contact rows */
  .contact{background:#fff;border-radius:16px;box-shadow:var(--shadow);overflow:hidden}
  .crow{display:flex;align-items:center;gap:11px;padding:12px 13px;border-bottom:1px solid var(--line)}.crow:last-child{border:none}
  .crow .cc{width:30px;height:30px;border-radius:9px;background:var(--blue-50);display:grid;place-items:center;flex:none}.crow .cc svg{width:16px;height:16px;stroke:var(--blue)}
  .crow .ct{flex:1}.crow .ct .a{font-size:13px;font-weight:600}.crow .ct .b{font-size:11px;color:var(--gray)}
  .copy{font-size:11px;font-weight:700;color:var(--orange-600);background:#FFF1E8;padding:5px 10px;border-radius:8px;display:flex;align-items:center;gap:4px}.copy svg{width:12px;height:12px;stroke:var(--orange-600)}

  /* trip detail bits */
  .accordion{background:#fff;border-radius:14px;box-shadow:var(--shadow);overflow:hidden;margin-bottom:8px}
  .acc-head{display:flex;align-items:center;gap:10px;padding:12px 13px}
  .acc-day{width:30px;height:30px;border-radius:9px;background:var(--blue);color:#fff;font-weight:800;font-size:11px;display:grid;place-items:center;flex:none}
  .acc-head .at{flex:1}.acc-head .at .a{font-size:13px;font-weight:600}.acc-head .at .b{font-size:10.5px;color:var(--gray)}
  .acc-head .chev svg{width:16px;height:16px;stroke:var(--gray-400)}
  .acc-body{padding:0 13px 12px 53px;font-size:11.5px;color:var(--gray)}
  .acc-body .li{display:flex;gap:7px;margin-top:7px}.acc-body .li svg{width:13px;height:13px;stroke:var(--orange-600);flex:none;margin-top:1px}
  .incl{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:6px}
  .incl .i{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ink);font-weight:500}.incl .i svg{width:14px;height:14px;stroke:var(--green);flex:none}
  .reviewbox{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:12px;margin-bottom:8px}
  .stars{display:flex;gap:3px}.stars svg{width:16px;height:16px;fill:var(--orange);stroke:var(--orange)}.stars svg.off{fill:none;stroke:#D6DCE6}
  .rv{display:flex;gap:9px;padding:10px 0;border-bottom:1px solid var(--line)}.rv:last-child{border:none}
  .rv .ra{width:32px;height:32px;border-radius:9px;flex:none;background:linear-gradient(135deg,#1E40AF,#3B5BDB);color:#fff;display:grid;place-items:center;font-size:12px;font-weight:700}
  .rv .rc .rn{font-size:12px;font-weight:700}.rv .rc .rt{font-size:11px;color:var(--gray);margin-top:3px;line-height:1.45}
  .rv-imgs{display:flex;gap:5px;margin-top:6px}.rv-imgs i{width:42px;height:42px;border-radius:8px;display:block}

  /* booking form */
  .segment{display:flex;background:#EEF1F6;border-radius:12px;padding:4px;margin-top:12px}
  .segment .sg{flex:1;text-align:center;font-size:12.5px;font-weight:700;padding:9px;border-radius:9px;color:var(--gray)}
  .segment .sg.active{background:#fff;color:var(--blue);box-shadow:0 2px 6px rgba(15,23,42,.08)}
  .field{margin-top:10px}.field label{font-size:11.5px;font-weight:600;color:var(--gray);display:block;margin-bottom:5px}
  .input{height:42px;background:#fff;border:1px solid var(--line);border-radius:11px;display:flex;align-items:center;padding:0 12px;font-size:13px;color:var(--ink)}
  .input.ph{color:var(--gray-400)}
  .traveler{background:#fff;border-radius:12px;box-shadow:var(--shadow);padding:11px 12px;margin-top:9px}
  .traveler .th{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
  .traveler .th b{font-size:12.5px}.traveler .th .del{font-size:11px;color:#DC2626;font-weight:600}
  .add-row{display:flex;align-items:center;justify-content:center;gap:6px;height:42px;border:1.5px dashed var(--blue-100);border-radius:11px;color:var(--blue);font-size:12.5px;font-weight:700;margin-top:9px}
  .add-row svg{width:16px;height:16px;stroke:var(--blue)}
  .fee{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:12px;margin-top:12px}
  .fee .fr{display:flex;justify-content:space-between;font-size:12.5px;padding:5px 0;color:var(--gray)}
  .fee .fr b{color:var(--ink)}.fee .fr.total{border-top:1px dashed var(--line);margin-top:5px;padding-top:9px;font-size:14px}
  .fee .fr.total .amt{font-family:'Poppins',sans-serif;color:var(--orange-600);font-size:18px}
  .member-tag{font-size:10px;font-weight:700;color:var(--green);background:#DCFCE7;padding:2px 7px;border-radius:6px;margin-left:6px}

  /* process steps */
  .steps{position:relative;margin-top:12px;padding-left:4px}
  .stp{display:flex;gap:12px;padding-bottom:14px;position:relative}
  .stp .sl{position:absolute;left:15px;top:4px;bottom:-4px;width:2px;background:var(--blue-100)}
  .stp:last-child .sl{display:none}
  .stp .sn{width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:800;font-size:13px;flex:none;z-index:1}
  .stp .sc{flex:1;padding-top:4px}.stp .sc .a{font-size:13px;font-weight:700}.stp .sc .b{font-size:11.5px;color:var(--gray);margin-top:2px}

  /* coop type grid */
  .coop{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
  .cop{background:#fff;border-radius:15px;box-shadow:var(--shadow);padding:13px;position:relative;overflow:hidden}
  .cop .ci{width:36px;height:36px;border-radius:11px;background:var(--blue-50);display:grid;place-items:center;margin-bottom:9px}.cop .ci svg{width:19px;height:19px;stroke:var(--blue);fill:none}
  .cop .a{font-size:13px;font-weight:700;font-family:'Poppins',sans-serif}.cop .b{font-size:10.5px;color:var(--gray);margin-top:3px;line-height:1.35}

  /* upload */
  .upload{height:76px;border:1.5px dashed var(--blue-100);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:var(--blue);background:var(--blue-50)}
  .upload svg{width:22px;height:22px;stroke:var(--blue)}.upload span{font-size:11.5px;font-weight:600}.upload small{font-size:10px;color:var(--gray)}
  .ms-grid{display:flex;gap:7px;flex-wrap:wrap;margin-top:6px}
  .ms{font-size:11.5px;font-weight:600;padding:7px 12px;border-radius:10px;background:#fff;border:1px solid var(--line);color:var(--gray)}
  .ms.on{background:var(--blue);color:#fff;border-color:var(--blue)}

  /* orders */
  .ordertab{display:flex;border-bottom:1px solid var(--line);background:#fff;margin:0 -16px}
  .ot{flex:1;text-align:center;font-size:13px;font-weight:700;padding:12px 0;color:var(--gray);position:relative}
  .ot.active{color:var(--blue)}.ot.active::after{content:"";position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:34px;height:3px;border-radius:2px;background:var(--blue)}
  .order{background:#fff;border-radius:16px;box-shadow:var(--shadow);overflow:hidden;margin-top:11px}
  .order .oh{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;border-bottom:1px solid var(--line)}
  .order .oh .on{font-size:11px;color:var(--gray);font-weight:600}
  .order .ob{padding:12px 13px}
  .order .ob .ot2{font-size:14px;font-family:'Poppins',sans-serif;font-weight:600}
  .order .ob .om{font-size:11px;color:var(--gray);margin-top:3px}
  .order .oa{display:flex;gap:8px;padding:0 13px 13px}
  .oa .ab{flex:1;text-align:center;font-size:11.5px;font-weight:700;padding:9px;border-radius:10px}
  .ab.ghost{background:var(--blue-50);color:var(--blue)}.ab.solid{background:var(--orange);color:#fff}
  .checklist{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:12px;margin-top:11px}
  .cl{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:12.5px}
  .cl .cb{width:20px;height:20px;border-radius:6px;flex:none;display:grid;place-items:center;border:2px solid #D6DCE6}
  .cl .cb.on{background:var(--green);border-color:var(--green)}.cl .cb.on svg{width:12px;height:12px;stroke:#fff}
  .cl .cbt{flex:1}.cl.done .cbt{color:var(--gray-400);text-decoration:line-through}
