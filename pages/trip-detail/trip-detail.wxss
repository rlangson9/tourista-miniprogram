/* pages/trip-detail/trip-detail.wxss */
.detail-wrap { padding-bottom: 160rpx; }

/* Hero */
.detail-hero { 
  color: #fff; 
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  position: relative;
  overflow: hidden;
}
.detail-hero::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -30%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,.15) 0%, transparent 70%);
  border-radius: 50%;
}
.corridor {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,.2);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}
.corridor-ico { width: 24rpx; height: 24rpx; }
.detail-title { 
  font-size: 42rpx; 
  font-weight: 800; 
  margin-top: 8rpx;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,.3);
  position: relative;
  z-index: 1;
}
.detail-lead { 
  font-size: 24rpx; 
  opacity: .9; 
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}
.rating-star { width: 28rpx; height: 28rpx; }

/* Fee card */
.fee-card {
  margin: -24rpx 32rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 2;
}
.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
  color: var(--gray);
}
.fee-row b { color: var(--ink); }
.member-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--green);
  background: #DCFCE7;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 10rpx;
}

/* Includes section */
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.sec-more { font-size: 24rpx; color: var(--blue); font-weight: 600; }
.incl {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 0 32rpx;
}
.incl-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  padding: 20rpx;
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow);
}
.incl-ico { width: 32rpx; height: 32rpx; }

/* Accordion - Daily Itinerary */
.accordion {
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow);
  overflow: hidden;
  margin: 0 32rpx 20rpx;
}
.acc-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}
.acc-day {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--blue);
  color: #fff;
  font-weight: 800;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.acc-head .at { flex: 1; }
.acc-head .at .a { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.acc-head .at .b { font-size: 22rpx; color: var(--gray); margin-top: 4rpx; }
.acc-head .chev { flex: none; }
.acc-head .chev-ico { width: 32rpx; height: 32rpx; }
.acc-body {
  padding: 0 24rpx 24rpx 84rpx;
  font-size: 24rpx;
  color: var(--gray);
}
.acc-body .acc-li {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.acc-body .acc-li-ico { width: 26rpx; height: 26rpx; flex: none; margin-top: 4rpx; }

/* Day Details */
.t-day-details { margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid var(--line); }
.day-section { margin-bottom: 28rpx; }
.day-section:last-child { margin-bottom: 0; }
.day-section-title { 
  display: flex; 
  align-items: center; 
  gap: 12rpx; 
  font-size: 26rpx; 
  font-weight: 700; 
  color: var(--ink); 
  margin-bottom: 16rpx;
}
.day-section-icon { width: 36rpx; height: 36rpx; opacity: 0.8; }

/* Schedule */
.schedule-list { display: flex; flex-direction: column; gap: 14rpx; }
.schedule-item { 
  display: flex; 
  gap: 16rpx; 
  padding: 16rpx; 
  background: var(--bg-secondary); 
  border-radius: 16rpx;
}
.schedule-time { font-size: 22rpx; font-weight: 700; color: var(--blue); min-width: 80rpx; }
.schedule-content { flex: 1; }
.schedule-title { font-size: 24rpx; font-weight: 700; color: var(--ink); }
.schedule-desc { font-size: 20rpx; color: var(--gray); margin-top: 4rpx; }

/* Meetings */
.meeting-list { display: flex; flex-direction: column; gap: 16rpx; }
.meeting-card { 
  padding: 20rpx; 
  background: linear-gradient(135deg, #f8fafc 0%, #fff 100%); 
  border-radius: 16rpx; 
  border: 2rpx solid var(--line);
}
.meeting-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.meeting-company { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.meeting-type { font-size: 18rpx; padding: 6rpx 14rpx; border-radius: 20rpx; }
.tag-gov { background: rgba(30,64,175,.08); color: var(--blue); }
.tag-biz { background: rgba(255,140,66,.08); color: var(--orange-600); }
.tag-other { background: rgba(139,92,246,.08); color: #7c3aed; }
.meeting-detail { font-size: 22rpx; margin-bottom: 10rpx; line-height: 1.5; }
.meeting-label { color: var(--gray); }
.meeting-value { color: var(--ink); }
.meeting-outcome { background: rgba(16,185,129,.08); padding: 12rpx; border-radius: 12rpx; margin-top: 10rpx; }
.meeting-prep { margin-top: 14rpx; padding: 16rpx; background: rgba(251,191,36,.08); border-radius: 12rpx; border-left: 4rpx solid #f59e0b; }
.meeting-prep-title { font-size: 20rpx; font-weight: 700; color: #d97706; display: block; margin-bottom: 8rpx; }
.meeting-prep-text { font-size: 20rpx; color: #78350f; display: block; }

/* Activities */
.activity-list { display: flex; flex-direction: column; gap: 14rpx; }
.activity-item { display: flex; gap: 16rpx; padding: 16rpx; background: var(--bg-secondary); border-radius: 16rpx; }
.activity-icon-wrap { 
  width: 48rpx; 
  height: 48rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  background: linear-gradient(135deg, var(--blue), var(--blue-600)); 
  border-radius: 16rpx; 
  flex-shrink: 0;
}
.activity-icon { width: 28rpx; height: 28rpx; }
.activity-content { flex: 1; }
.activity-title { font-size: 24rpx; font-weight: 700; color: var(--ink); }
.activity-desc { font-size: 20rpx; color: var(--gray); margin-top: 6rpx; }
.activity-meta { font-size: 18rpx; color: var(--gray); margin-top: 8rpx; display: flex; gap: 16rpx; }

/* Meals */
.meal-list { display: flex; flex-direction: column; gap: 14rpx; }
.meal-item { display: flex; gap: 16rpx; padding: 16rpx; background: var(--bg-secondary); border-radius: 16rpx; }
.meal-type { font-size: 22rpx; font-weight: 700; color: var(--orange-600); min-width: 60rpx; }
.meal-content { flex: 1; }
.meal-venue { font-size: 24rpx; font-weight: 700; color: var(--ink); }
.meal-cuisine { font-size: 20rpx; color: var(--gray); margin-top: 4rpx; }
.meal-notes { font-size: 18rpx; color: var(--gray); margin-top: 4rpx; font-style: italic; }

/* Accommodation */
.accommodation-card { 
  padding: 20rpx; 
  background: linear-gradient(135deg, #f8fafc 0%, #fff 100%); 
  border-radius: 16rpx; 
  border: 2rpx solid var(--line);
}
.hotel-name { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.hotel-rating { margin-top: 8rpx; }
.hotel-detail { font-size: 22rpx; margin-top: 10rpx; }
.hotel-label { color: var(--gray); }
.hotel-value { color: var(--ink); }
.hotel-amenities { font-size: 20rpx; color: var(--gray); margin-top: 8rpx; }
.hotel-address { font-size: 20rpx; color: var(--gray); margin-top: 8rpx; }

/* Transport */
.transport-list { display: flex; flex-direction: column; gap: 10rpx; }
.transport-item { display: flex; gap: 16rpx; padding: 12rpx 16rpx; background: var(--bg-secondary); border-radius: 12rpx; }
.transport-type { font-size: 20rpx; font-weight: 700; color: var(--blue); min-width: 80rpx; }
.transport-detail { font-size: 20rpx; color: var(--ink); }

/* Tips */
.day-tips { background: rgba(251,191,36,.08); padding: 20rpx; border-radius: 16rpx; margin-top: 20rpx; }
.tips-content { font-size: 22rpx; color: #78350f; line-height: 1.7; }

/* Includes */
.includes { margin: 0 32rpx; padding: 16rpx 28rpx; }
.inc-row { display: flex; align-items: center; padding: 14rpx 0; }
.inc-row + .inc-row { border-top: 2rpx solid var(--line); }
.inc-check { margin-right: 16rpx; width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; }
.inc-check-img { width: 24rpx; height: 24rpx; }
.inc-text { font-size: 24rpx; color: var(--ink); }

.detail-pad { height: 30rpx; }

/* Sticky bar */
.bar-sub { font-size: 22rpx; color: var(--gray); margin-top: 4rpx; }
.bar-btn { padding: 20rpx 32rpx; font-size: 26rpx; }
.bar-btn-main { padding: 20rpx 48rpx; font-size: 28rpx; }

/* Reviews */
.review-count { font-size: 24rpx; color: var(--gray); margin-left: 10rpx; }
.review-rating { display: inline-flex; align-items: center; margin-left: 14rpx; }
.star { font-size: 28rpx; color: #e2e8f0; margin-right: 2rpx; }
.star-active { color: var(--amber); }
.star-inactive { color: #e2e8f0; }
.rating-num { font-size: 24rpx; color: var(--amber); margin-left: 10rpx; font-weight: 700; }

/* Review box */
.reviewbox {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin: 0 32rpx 20rpx;
}
.review-summary {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
}
.review-score {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
}
.review-stars { display: flex; }
.review-stars-icon { width: 32rpx; height: 32rpx; }
.review-stats { font-size: 22rpx; color: var(--gray); margin-top: 8rpx; }

/* Review Item */
.review-item {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.review-item:last-child { border: none; }
.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  flex: none;
  background: linear-gradient(135deg, var(--blue), var(--blue-600));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.review-info { flex: 1; }
.review-name { font-size: 24rpx; font-weight: 700; color: var(--ink); }
.review-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 6rpx; }
.review-date { font-size: 20rpx; color: var(--gray); }
.review-title { font-size: 26rpx; font-weight: 700; margin-top: 14rpx; color: var(--ink); }
.review-content { font-size: 24rpx; color: var(--ink-lighter); line-height: 1.7; margin-top: 10rpx; }

/* Review Media */
.review-media { margin-top: 14rpx; }
.media-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.media-item { width: 120rpx; height: 120rpx; position: relative; border-radius: 12rpx; overflow: hidden; }
.media-img { width: 100%; height: 100%; }
.media-video-badge { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; font-size: 28rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5); }

/* Review Actions */
.review-actions { display: flex; gap: 36rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 2rpx solid var(--line); }
.action-item { display: flex; align-items: center; gap: 10rpx; }
.action-icon { font-size: 28rpx; }
.action-text { font-size: 22rpx; color: var(--gray); }

/* Review Comments */
.review-comments { margin-top: 20rpx; padding-top: 16rpx; border-top: 2rpx solid var(--line); background: var(--bg-secondary); border-radius: 16rpx; padding: 16rpx; }
.comment-item { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.comment-item:last-child { margin-bottom: 0; }
.comment-avatar { width: 52rpx; height: 52rpx; opacity: 0.4; }
.comment-content { flex: 1; background: #fff; border-radius: 12rpx; padding: 14rpx 18rpx; }
.comment-header { display: flex; justify-content: space-between; align-items: center; }
.comment-name { font-size: 22rpx; font-weight: 700; color: var(--ink); }
.comment-date { font-size: 18rpx; color: var(--gray); }
.comment-text { font-size: 22rpx; color: var(--ink-lighter); margin-top: 8rpx; }
.comment-input-wrap { display: flex; gap: 14rpx; margin-top: 16rpx; }
.comment-input { flex: 1; height: 72rpx; border: 2rpx solid var(--line); border-radius: 36rpx; padding: 0 24rpx; font-size: 24rpx; }

/* Empty Reviews */
.empty-reviews { margin: 24rpx 32rpx; padding: 60rpx; text-align: center; }
.empty-icon { width: 100rpx; height: 100rpx; margin: 0 auto; opacity: 0.4; }
.empty-text { font-size: 28rpx; font-weight: 700; margin-top: 20rpx; color: var(--ink); }
.empty-hint { font-size: 24rpx; color: var(--gray); margin-top: 12rpx; }

/* Write Review Button */
.review-write { margin: 24rpx 32rpx; padding: 28rpx; display: flex; align-items: center; gap: 24rpx; }
.review-write-avatar { width: 72rpx; height: 72rpx; opacity: 0.4; }
.review-write-content { flex: 1; }
.review-write-title { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.review-write-hint { font-size: 22rpx; color: var(--gray); margin-top: 6rpx; }
.review-write-arrow { font-size: 36rpx; color: var(--gray); }

/* Write Review Modal */
.modal-overlay {
  position: fixed; 
  top: 0; 
  left: 0; 
  right: 0; 
  bottom: 0;
  background: rgba(15,23,42,.55); 
  z-index: 1000;
  display: flex; 
  align-items: flex-end;
  animation: fadeIn var(--transition-fast);
}

.modal-content {
  width: 100%; 
  max-height: 85vh;
  background: #fff; 
  border-radius: 48rpx 48rpx 0 0;
  overflow: hidden;
  animation: slideUp var(--transition-normal);
}

.modal-header {
  display: flex; 
  align-items: center; 
  justify-content: space-between;
  padding: 32rpx; 
  border-bottom: 2rpx solid var(--line);
}

.modal-title { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.modal-close {
  width: 56rpx; 
  height: 56rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center;
  font-size: 48rpx; 
  color: var(--gray);
}

.modal-body { padding: 32rpx; max-height: 60vh; overflow-y: auto; }
.modal-footer { padding: 24rpx 32rpx 36rpx; }

/* Review Form */
.review-form { display: flex; flex-direction: column; gap: 28rpx; }
.form-item { display: flex; flex-direction: column; gap: 14rpx; }
.form-label { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.rating-stars { display: flex; gap: 20rpx; }
.rating-stars .star { font-size: 48rpx; cursor: pointer; }
.form-input {
  height: 88rpx; 
  border: 2rpx solid var(--line); 
  border-radius: 16rpx;
  padding: 0 24rpx; 
  font-size: 26rpx;
}
.form-textarea {
  height: 180rpx; 
  border: 2rpx solid var(--line); 
  border-radius: 16rpx;
  padding: 20rpx 24rpx; 
  font-size: 26rpx;
}

/* Upload Area */
.upload-area {
  height: 180rpx; 
  border: 2rpx dashed var(--line); 
  border-radius: 16rpx;
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center;
  gap: 12rpx;
}
.upload-icon { width: 56rpx; height: 56rpx; opacity: 0.4; }
.upload-text { font-size: 24rpx; color: var(--gray); }

/* Upload Preview */
.upload-preview { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.preview-item { width: 160rpx; height: 160rpx; position: relative; border-radius: 16rpx; overflow: hidden; }
.preview-img { width: 100%; height: 100%; }
.preview-remove {
  position: absolute; 
  top: 8rpx; 
  right: 8rpx;
  width: 40rpx; 
  height: 40rpx; 
  background: rgba(0,0,0,.7);
  border-radius: 50%; 
  display: flex; 
  align-items: center; 
  justify-content: center;
  color: #fff; 
  font-size: 28rpx;
}
.preview-video-badge {
  position: absolute; 
  top: 50%; 
  left: 50%; 
  transform: translate(-50%, -50%);
  color: #fff; 
  font-size: 32rpx; 
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5);
}