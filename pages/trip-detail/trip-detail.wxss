/* pages/trip-detail/trip-detail.wxss */
.detail-wrap { padding-bottom: 140rpx; }

.detail-hero { color: #fff; padding: 24rpx 32rpx 32rpx; }
.hero-flag { background: rgba(0,0,0,.3); color: #fff; }
.detail-title { font-size: 34rpx; font-weight: 700; margin-top: 16rpx; }
.detail-lead { font-size: 21rpx; opacity: .8; margin-top: 6rpx; }

/* Timeline */
.timeline { margin: 0 28rpx; position: relative; padding-left: 44rpx; }
.t-line {
  position: absolute; left: 14rpx; top: 12rpx; bottom: 12rpx; width: 4rpx;
  background: linear-gradient(180deg, var(--primary), var(--primary-light));
}
.t-item { position: relative; margin-bottom: 20rpx; }
.t-node {
  position: absolute; left: -44rpx; top: 4rpx;
  width: 28rpx; height: 28rpx; border-radius: 50%;
  background: #fff; border: 4rpx solid var(--primary);
  font-size: 16rpx; font-weight: 700; color: var(--secondary);
  display: flex; align-items: center; justify-content: center;
}
.t-node-leisure { border-color: var(--accent); }
.t-card { padding: 16rpx 20rpx; transition: all 0.3s ease; }
.t-expanded { padding-bottom: 0; }
.t-vip { border-left: 6rpx solid var(--accent); }
.t-leisure { background: rgba(255,210,63,0.1); border: 1rpx solid rgba(255,210,63,0.3); }

/* Card Header */
.t-card-header { display: flex; align-items: flex-start; justify-content: space-between; }
.t-card-title-wrap { flex: 1; }
.t-card-title { font-size: 23rpx; font-weight: 700; }
.t-leisure-title { color: var(--accent-dark); }
.t-vip-tag { margin-left: 8rpx; }
.t-card-desc { font-size: 19rpx; color: var(--grey); margin-top: 4rpx; line-height: 1.5; }
.t-leisure-desc { color: var(--accent-dark); }
.t-expand-btn { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.t-expand-icon { font-size: 36rpx; color: var(--grey); transition: transform 0.3s ease; }
.t-expand-rotated { transform: rotate(90deg); }

/* Day Details */
.t-day-details { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }

/* Day Section */
.day-section { margin-bottom: 24rpx; }
.day-section:last-child { margin-bottom: 0; }
.day-section-title { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; font-weight: 600; color: var(--secondary); margin-bottom: 16rpx; }
.day-section-icon { width: 32rpx; height: 32rpx; opacity: 0.8; }

/* Schedule */
.schedule-list { display: flex; flex-direction: column; gap: 12rpx; }
.schedule-item { display: flex; gap: 16rpx; padding: 12rpx 16rpx; background: #f8f9fa; border-radius: 12rpx; }
.schedule-time { font-size: 20rpx; font-weight: 600; color: var(--primary); min-width: 80rpx; }
.schedule-content { flex: 1; }
.schedule-title { font-size: 20rpx; font-weight: 600; color: #333; }
.schedule-desc { font-size: 18rpx; color: var(--grey); margin-top: 4rpx; }

/* Meetings */
.meeting-list { display: flex; flex-direction: column; gap: 16rpx; }
.meeting-card { padding: 16rpx; background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%); border-radius: 12rpx; border: 1rpx solid var(--line); }
.meeting-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.meeting-company { font-size: 22rpx; font-weight: 700; color: var(--secondary); }
.meeting-type { font-size: 16rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.tag-gov { background: #e3f2fd; color: #1976d2; }
.tag-biz { background: #fff3e0; color: #f57c00; }
.tag-other { background: #f3e5f5; color: #7b1fa2; }
.meeting-detail { font-size: 19rpx; margin-bottom: 8rpx; line-height: 1.5; }
.meeting-label { color: var(--grey); }
.meeting-value { color: #333; }
.meeting-outcome { background: #e8f5e9; padding: 8rpx 12rpx; border-radius: 8rpx; margin-top: 8rpx; }
.meeting-prep { margin-top: 12rpx; padding: 12rpx; background: #fff8e1; border-radius: 8rpx; border-left: 4rpx solid #ffc107; }
.meeting-prep-title { font-size: 18rpx; font-weight: 600; color: #f57c00; display: block; margin-bottom: 6rpx; }
.meeting-prep-text { font-size: 18rpx; color: #666; display: block; }

/* Activities */
.activity-list { display: flex; flex-direction: column; gap: 12rpx; }
.activity-item { display: flex; gap: 12rpx; padding: 12rpx; background: #f8f9fa; border-radius: 12rpx; }
.activity-icon-wrap { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; background: var(--primary); border-radius: 50%; flex-shrink: 0; }
.activity-icon { width: 24rpx; height: 24rpx; }
.activity-content { flex: 1; }
.activity-title { font-size: 20rpx; font-weight: 600; color: #333; }
.activity-desc { font-size: 18rpx; color: var(--grey); margin-top: 4rpx; }
.activity-meta { font-size: 16rpx; color: var(--grey); margin-top: 6rpx; display: flex; gap: 16rpx; }

/* Meals */
.meal-list { display: flex; flex-direction: column; gap: 12rpx; }
.meal-item { display: flex; gap: 16rpx; padding: 12rpx 16rpx; background: #f8f9fa; border-radius: 12rpx; }
.meal-type { font-size: 18rpx; font-weight: 600; color: var(--primary); min-width: 60rpx; }
.meal-content { flex: 1; }
.meal-venue { font-size: 20rpx; font-weight: 600; color: #333; }
.meal-cuisine { font-size: 18rpx; color: var(--grey); margin-top: 4rpx; }
.meal-notes { font-size: 16rpx; color: var(--grey); margin-top: 4rpx; font-style: italic; }

/* Accommodation */
.accommodation-card { padding: 16rpx; background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%); border-radius: 12rpx; border: 1rpx solid var(--line); }
.hotel-name { font-size: 22rpx; font-weight: 700; color: var(--secondary); }
.hotel-rating { margin-top: 6rpx; }
.hotel-detail { font-size: 19rpx; margin-top: 8rpx; }
.hotel-label { color: var(--grey); }
.hotel-value { color: #333; }
.hotel-amenities { font-size: 18rpx; color: var(--grey); margin-top: 8rpx; }
.hotel-address { font-size: 18rpx; color: var(--grey); margin-top: 8rpx; }

/* Transport */
.transport-list { display: flex; flex-direction: column; gap: 8rpx; }
.transport-item { display: flex; gap: 16rpx; padding: 10rpx 16rpx; background: #f8f9fa; border-radius: 8rpx; }
.transport-type { font-size: 18rpx; font-weight: 600; color: var(--primary); min-width: 80rpx; }
.transport-detail { font-size: 18rpx; color: #333; }

/* Tips */
.day-tips { background: #fff8e1; padding: 16rpx; border-radius: 12rpx; margin-top: 16rpx; }
.tips-content { font-size: 19rpx; color: #666; line-height: 1.6; }

/* Includes */
.includes { margin: 0 28rpx; padding: 12rpx 24rpx; }
.inc-row { display: flex; align-items: center; padding: 12rpx 0; }
.inc-row + .inc-row { border-top: 1rpx solid var(--line); }
.inc-check { margin-right: 14rpx; width: 28rpx; height: 28rpx; display: flex; align-items: center; justify-content: center; }
.inc-check-img { width: 20rpx; height: 20rpx; }
.inc-text { font-size: 22rpx; color: #444; }

.detail-pad { height: 30rpx; }

/* Sticky bar */
.bar-sub { font-size: 19rpx; color: var(--grey); margin-top: 2rpx; }
.bar-btn { padding: 18rpx 28rpx; font-size: 26rpx; }
.bar-btn-main { padding: 18rpx 40rpx; font-size: 26rpx; }

/* Reviews */
.review-count { font-size: 22rpx; color: var(--grey); margin-left: 8rpx; }
.review-rating { display: inline-flex; align-items: center; margin-left: 12rpx; }
.star { font-size: 24rpx; color: #ddd; margin-right: 2rpx; }
.star-active { color: var(--accent); }
.star-inactive { color: #ddd; }
.rating-num { font-size: 22rpx; color: var(--accent); margin-left: 8rpx; font-weight: 600; }

/* Write Review Button */
.review-write { margin: 20rpx 28rpx; padding: 24rpx; display: flex; align-items: center; gap: 20rpx; }
.review-write-avatar { width: 64rpx; height: 64rpx; opacity: 0.5; }
.review-write-content { flex: 1; }
.review-write-title { font-size: 26rpx; font-weight: 600; }
.review-write-hint { font-size: 20rpx; color: var(--grey); margin-top: 4rpx; }
.review-write-arrow { font-size: 32rpx; color: var(--grey); }

/* Review Item */
.review-item { margin: 20rpx 28rpx; padding: 24rpx; }
.review-header { display: flex; gap: 16rpx; }
.review-avatar { width: 56rpx; height: 56rpx; opacity: 0.6; }
.review-info { flex: 1; }
.review-name { font-size: 24rpx; font-weight: 600; }
.review-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 4rpx; }
.review-date { font-size: 18rpx; color: var(--grey); }
.review-title { font-size: 26rpx; font-weight: 600; margin-top: 16rpx; }
.review-content { font-size: 22rpx; color: #444; line-height: 1.6; margin-top: 12rpx; }

/* Review Media */
.review-media { margin-top: 16rpx; }
.media-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.media-item { width: 140rpx; height: 140rpx; position: relative; border-radius: 12rpx; overflow: hidden; }
.media-img { width: 100%; height: 100%; }
.media-video-badge { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; font-size: 32rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5); }

/* Review Actions */
.review-actions { display: flex; gap: 32rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.action-item { display: flex; align-items: center; gap: 8rpx; }
.action-icon { font-size: 28rpx; }
.action-text { font-size: 22rpx; color: var(--grey); }

/* Review Comments */
.review-comments { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); background: #f8f8f8; border-radius: 12rpx; padding: 16rpx; }
.comment-item { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.comment-item:last-child { margin-bottom: 0; }
.comment-avatar { width: 48rpx; height: 48rpx; opacity: 0.5; }
.comment-content { flex: 1; background: #fff; border-radius: 8rpx; padding: 12rpx 16rpx; }
.comment-header { display: flex; justify-content: space-between; align-items: center; }
.comment-name { font-size: 20rpx; font-weight: 600; }
.comment-date { font-size: 16rpx; color: var(--grey); }
.comment-text { font-size: 20rpx; color: #444; margin-top: 6rpx; }
.comment-input-wrap { display: flex; gap: 12rpx; margin-top: 16rpx; }
.comment-input { flex: 1; height: 64rpx; border: 1rpx solid var(--line); border-radius: 32rpx; padding: 0 20rpx; font-size: 22rpx; }

/* Empty Reviews */
.empty-reviews { margin: 20rpx 28rpx; padding: 48rpx; text-align: center; }
.empty-icon { width: 80rpx; height: 80rpx; margin: 0 auto; opacity: 0.5; }
.empty-text { font-size: 26rpx; font-weight: 600; margin-top: 16rpx; }
.empty-hint { font-size: 22rpx; color: var(--grey); margin-top: 8rpx; }

/* Write Review Modal */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: flex-end;
}

.modal-content {
  width: 100%; max-height: 85vh;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--line);
}

.modal-title { font-size: 32rpx; font-weight: 700; }
.modal-close {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: #999;
}

.modal-body { padding: 24rpx 32rpx; max-height: 60vh; overflow-y: auto; }
.modal-footer { padding: 20rpx 32rpx 32rpx; }

/* Review Form */
.review-form { display: flex; flex-direction: column; gap: 24rpx; }
.form-item { display: flex; flex-direction: column; gap: 12rpx; }
.form-label { font-size: 24rpx; font-weight: 600; }
.rating-stars { display: flex; gap: 16rpx; }
.rating-stars .star { font-size: 40rpx; cursor: pointer; }
.form-input {
  height: 80rpx; border: 1rpx solid var(--line); border-radius: 12rpx;
  padding: 0 20rpx; font-size: 24rpx;
}
.form-textarea {
  height: 160rpx; border: 1rpx solid var(--line); border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 24rpx;
}

/* Upload Area */
.upload-area {
  height: 160rpx; border: 2rpx dashed var(--line); border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8rpx;
}
.upload-icon { width: 48rpx; height: 48rpx; opacity: 0.5; }
.upload-text { font-size: 22rpx; color: var(--grey); }

/* Upload Preview */
.upload-preview { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.preview-item { width: 140rpx; height: 140rpx; position: relative; border-radius: 12rpx; overflow: hidden; }
.preview-img { width: 100%; height: 100%; }
.preview-remove {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx; background: rgba(0,0,0,.6);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 24rpx;
}
.preview-video-badge {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  color: #fff; font-size: 28rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5);
}
