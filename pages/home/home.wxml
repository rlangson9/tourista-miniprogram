<!-- pages/home/home.wxml -->
<view class="page-wrap">

  <!-- Hero -->
  <view class="hero">
    <view class="hero-title">{{i18n.heroTitle}}</view>
    <view class="hero-sub">{{i18n.heroSub}}</view>

    <!-- Signature dual-mode entry -->
    <view class="dual">
      <view class="dual-card dual-primary" bindtap="goTrips">
        <view class="dual-t"><image class="dual-ico" src="/images/icon-airplane.svg" mode="aspectFit"/> {{i18n.goToAfrica}}</view>
        <view class="dual-d">{{i18n.goToAfricaDesc}}</view>
      </view>
      <view class="dual-card dual-accent" bindtap="goBusiness">
        <view class="dual-t"><image class="dual-ico" src="/images/icon-handshake.svg" mode="aspectFit"/> {{i18n.doBusiness}}</view>
        <view class="dual-d">{{i18n.doBusinessDesc}}</view>
      </view>
    </view>
  </view>

  <!-- Trust bar -->
  <view class="trust card">
    <view class="trust-item" wx:for="{{stats}}" wx:key="label">
      <view class="trust-num">{{item.num}}</view>
      <view class="trust-lbl">{{item.label}}</view>
    </view>
  </view>

  <!-- Featured trip -->
  <view class="sec-title">{{i18n.recentTrips}} <text class="sec-more" bindtap="goTrips">{{i18n.viewAll}} ›</text></view>
  <view class="card feat" bindtap="openTrip" data-id="zw">
    <view class="feat-banner" style="background: {{featured.gradient}};">
      <text class="tag feat-hot"><image class="feat-hot-ico" src="/images/icon-fire.svg" mode="aspectFit"/> {{i18n.registering}}</text>
      <view class="feat-title">{{featuredTitle}}</view>
      <view class="feat-meta">{{featured.dateRange}} · {{featured.structure}}</view>
    </view>
    <view class="feat-foot">
      <view>
        <text class="price">¥{{featured.memberPriceText}}</text>
        <text class="price-unit"> {{i18n.per}} · {{featured.seatTag}}</text>
      </view>
      <view class="btn btn-primary feat-btn" catchtap="openTrip" data-id="zw">{{i18n.bookNow}}</view>
    </view>
  </view>

  <!-- Success stories -->
  <view class="sec-title" bindtap="showStoriesModal">{{i18n.successStories}} 
    <view class="sec-actions" catchtap="noop">
      <view class="sec-filter" catchtap="toggleStoryDropdown">
        <image class="sec-filter-ico" src="/images/icon-filter.svg" mode="aspectFit"/>
        <text>{{i18n.filter}}</text>
      </view>
      <text class="sec-more" catchtap="showStoriesModal">{{i18n.viewAll}} ›</text>
    </view>
  </view>
  <!-- Story filter dropdown -->
  <view class="filter-dropdown" wx:if="{{showStoryDropdown}}">
    <view class="filter-dropdown-item {{storyFilter === 'all' ? 'filter-dropdown-active' : ''}}" catchtap="setStoryFilter" data-filter="all">{{i18n.all}}</view>
    <view class="filter-dropdown-item {{storyFilter === 'business' ? 'filter-dropdown-active' : ''}}" catchtap="setStoryFilter" data-filter="business">{{i18n.business}}</view>
    <view class="filter-dropdown-item {{storyFilter === 'investment' ? 'filter-dropdown-active' : ''}}" catchtap="setStoryFilter" data-filter="investment">{{i18n.investment}}</view>
    <view class="filter-dropdown-item {{storyFilter === 'tour' ? 'filter-dropdown-active' : ''}}" catchtap="setStoryFilter" data-filter="tour">{{i18n.tour}}</view>
  </view>
  <view class="stories-strip">
    <view class="story-card card" wx:for="{{filteredStories}}" wx:key="id" bindtap="openStoryDetail" data-id="{{item.id}}">
      <view class="story-cover">
        <image wx:if="{{item.media.length > 0}}" class="story-img" src="{{item.media[0].url}}" mode="aspectFill"/>
        <view wx:else class="story-cover-placeholder">
          <image class="story-placeholder-ico" src="/images/icon-crown.svg" mode="aspectFit"/>
        </view>
        <view class="story-category tag">{{item.categoryText}}</view>
      </view>
      <view class="story-content">
        <view class="story-title">{{item.title}}</view>
        <view class="story-company">{{item.company}}</view>
        <view class="story-summary">{{item.summary}}</view>
        <view class="story-actions">
          <view class="story-action-btn" catchtap="askAboutStory" data-id="{{item.id}}">
            <image class="story-action-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
            <text>{{i18n.ask}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{filteredStories.length === 0}}" class="empty-strip">
      <text>{{i18n.noResults}}</text>
    </view>
  </view>

  <!-- Opportunities -->
  <view class="sec-title" bindtap="showOpportunitiesModal">{{i18n.opportunities}} 
    <view class="sec-actions" catchtap="noop">
      <view class="sec-filter" catchtap="toggleOppDropdown">
        <image class="sec-filter-ico" src="/images/icon-filter.svg" mode="aspectFit"/>
        <text>{{i18n.filter}}</text>
      </view>
      <text class="sec-more" catchtap="showOpportunitiesModal">{{i18n.viewAll}} ›</text>
    </view>
  </view>
  <!-- Opportunity filter dropdown -->
  <view class="filter-dropdown" wx:if="{{showOppDropdown}}">
    <view class="filter-dropdown-row">
      <text class="filter-dropdown-label">{{i18n.type}}</text>
      <view class="filter-dropdown-options">
        <view class="filter-dropdown-chip {{oppTypeFilter === 'all' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppTypeFilter" data-filter="all">{{i18n.all}}</view>
        <view class="filter-dropdown-chip {{oppTypeFilter === 'opportunity' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppTypeFilter" data-filter="opportunity">{{i18n.opportunity}}</view>
        <view class="filter-dropdown-chip {{oppTypeFilter === 'demand' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppTypeFilter" data-filter="demand">{{i18n.demand}}</view>
      </view>
    </view>
    <view class="filter-dropdown-row">
      <text class="filter-dropdown-label">{{i18n.category}}</text>
      <view class="filter-dropdown-options">
        <view class="filter-dropdown-chip {{oppCategoryFilter === 'all' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="all">{{i18n.allCategory}}</view>
        <view class="filter-dropdown-chip {{oppCategoryFilter === 'investment' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="investment">{{i18n.investment}}</view>
        <view class="filter-dropdown-chip {{oppCategoryFilter === 'trade' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="trade">{{i18n.trade}}</view>
        <view class="filter-dropdown-chip {{oppCategoryFilter === 'joint_venture' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="joint_venture">{{i18n.jointVenture}}</view>
        <view class="filter-dropdown-chip {{oppCategoryFilter === 'supply' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="supply">{{i18n.supply}}</view>
        <view class="filter-dropdown-chip {{oppCategoryFilter === 'project' ? 'filter-dropdown-chip-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="project">{{i18n.project}}</view>
      </view>
    </view>
  </view>
  <view class="opp-strip">
    <view class="opp-card card" wx:for="{{filteredOpportunities}}" wx:key="id">
      <view class="opp-header">
        <view class="opp-country">{{item.country}}</view>
        <view class="opp-type tag {{item.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{item.typeText}}</view>
      </view>
      <view class="opp-title" bindtap="openOpportunityDetail" data-id="{{item.id}}">{{item.title}}</view>
      <view class="opp-category">{{item.categoryText}}</view>
      <view class="opp-desc" bindtap="openOpportunityDetail" data-id="{{item.id}}">{{item.description}}</view>
      <view class="opp-footer" bindtap="openOpportunityDetail" data-id="{{item.id}}">
        <text wx:if="{{item.budget}}" class="opp-budget">Budget: {{item.budget}}</text>
        <text wx:if="{{item.deadline}}" class="opp-deadline">{{item.deadline}}</text>
      </view>
      <view class="opp-actions">
        <view class="opp-action-btn btn-primary" catchtap="submitOpportunityIntent" data-id="{{item.id}}">
          <image class="opp-action-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
          <text>{{i18n.submitIntent}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{filteredOpportunities.length === 0}}" class="empty-strip">
      <text>{{i18n.noResults}}</text>
    </view>
  </view>

  <!-- Business strip -->
  <view class="sec-title">{{i18n.businessChannel}} <text class="sec-more" bindtap="showAllOpportunities">{{i18n.learnMore}} ›</text></view>
  <view class="biz-strip">
    <view class="biz-mini card" wx:for="{{bizMini}}" wx:key="title" bindtap="showAllOpportunities">
      <view class="biz-ico"><image class="biz-img" src="{{item.icon}}" mode="aspectFit"/></view>
      <view class="biz-t">{{item.title}}</view>
      <view class="biz-d">{{item.desc}}</view>
    </view>
  </view>

</view>

<!-- All Stories List Modal (full screen) -->
<view class="modal-mask" wx:if="{{showAllStoriesModal}}" bindtap="closeAllStoriesModal">
  <view class="modal-content all-stories-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{i18n.successStories}}</text>
      <view class="modal-close" bindtap="closeAllStoriesModal">×</view>
    </view>
    <view class="modal-filters">
      <view class="filter-tabs">
        <view class="filter-tab {{storyFilter === 'all' ? 'filter-tab-active' : ''}}" catchtap="setStoryFilter" data-filter="all">{{i18n.all}}</view>
        <view class="filter-tab {{storyFilter === 'business' ? 'filter-tab-active' : ''}}" catchtap="setStoryFilter" data-filter="business">{{i18n.business}}</view>
        <view class="filter-tab {{storyFilter === 'investment' ? 'filter-tab-active' : ''}}" catchtap="setStoryFilter" data-filter="investment">{{i18n.investment}}</view>
        <view class="filter-tab {{storyFilter === 'tour' ? 'filter-tab-active' : ''}}" catchtap="setStoryFilter" data-filter="tour">{{i18n.tour}}</view>
      </view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="all-list">
        <view class="all-item card" wx:for="{{filteredStories}}" wx:key="id">
          <view class="all-item-header">
            <view class="all-item-title">{{item.title}}</view>
            <view class="tag">{{item.categoryText}}</view>
          </view>
          <view class="all-item-company">{{item.company}}</view>
          <view class="all-item-summary">{{item.summary}}</view>
          <view class="all-item-content">{{item.content}}</view>
          <view class="all-item-actions">
            <view class="btn btn-primary all-item-btn" catchtap="askAboutStory" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
              <text>{{i18n.askQuestion}}</text>
            </view>
            <view class="btn btn-secondary all-item-btn" catchtap="contactTeam" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
              <text>{{i18n.contactTeam}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{filteredStories.length === 0}}" class="empty-state">
          <text>{{i18n.noResults}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- All Opportunities / Business Partnership Modal (full screen) -->
<view class="modal-mask" wx:if="{{showAllOpportunitiesModal}}" bindtap="closeAllOpportunitiesModal">
  <view class="modal-content all-opp-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{i18n.businessChannel}}</text>
      <view class="modal-close" bindtap="closeAllOpportunitiesModal">×</view>
    </view>
    <!-- Type filters -->
    <view class="modal-filters">
      <view class="filter-tabs">
        <view class="filter-tab {{oppTypeFilter === 'all' ? 'filter-tab-active' : ''}}" catchtap="setOppTypeFilter" data-filter="all">{{i18n.all}}</view>
        <view class="filter-tab {{oppTypeFilter === 'opportunity' ? 'filter-tab-active' : ''}}" catchtap="setOppTypeFilter" data-filter="opportunity">{{i18n.opportunity}}</view>
        <view class="filter-tab {{oppTypeFilter === 'demand' ? 'filter-tab-active' : ''}}" catchtap="setOppTypeFilter" data-filter="demand">{{i18n.demand}}</view>
      </view>
    </view>
    <!-- Category filters -->
    <view class="modal-filters modal-filters-secondary">
      <view class="filter-tabs filter-tabs-wrap">
        <view class="filter-tab {{oppCategoryFilter === 'all' ? 'filter-tab-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="all">{{i18n.allCategory}}</view>
        <view class="filter-tab {{oppCategoryFilter === 'investment' ? 'filter-tab-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="investment">{{i18n.investment}}</view>
        <view class="filter-tab {{oppCategoryFilter === 'trade' ? 'filter-tab-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="trade">{{i18n.trade}}</view>
        <view class="filter-tab {{oppCategoryFilter === 'joint_venture' ? 'filter-tab-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="joint_venture">{{i18n.jointVenture}}</view>
        <view class="filter-tab {{oppCategoryFilter === 'supply' ? 'filter-tab-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="supply">{{i18n.supply}}</view>
        <view class="filter-tab {{oppCategoryFilter === 'project' ? 'filter-tab-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="project">{{i18n.project}}</view>
      </view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <!-- Contact section -->
      <view class="all-opp-contact card">
        <view class="all-opp-contact-title">{{i18n.contactTeam}}</view>
        <view class="all-opp-contact-info">
          <view class="all-opp-contact-row" catchtap="copyWeChat">
            <image class="all-opp-contact-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
            <text>{{i18n.weChat}}：touristaar</text>
            <text class="all-opp-contact-copy">{{i18n.copy}}</text>
          </view>
          <view class="all-opp-contact-row" catchtap="copyEmail">
            <image class="all-opp-contact-ico" src="/images/icon-info.svg" mode="aspectFit"/>
            <text>Email：rlangson91@touristaar.com</text>
            <text class="all-opp-contact-copy">{{i18n.copy}}</text>
          </view>
          <view class="all-opp-contact-row" catchtap="viewQRCode">
            <image class="all-opp-contact-ico" src="/images/icon-phone.svg" mode="aspectFit"/>
            <text>{{i18n.viewQRCode}}</text>
            <text class="all-opp-contact-copy">{{i18n.view}}</text>
          </view>
        </view>
      </view>
      <!-- Opportunities list -->
      <view class="all-opp-section-title">{{i18n.opportunities}}</view>
      <view class="all-list">
        <view class="all-item card" wx:for="{{filteredOpportunities}}" wx:key="id">
          <view class="all-item-header">
            <view class="all-item-title">{{item.title}}</view>
            <view class="tag {{item.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{item.typeText}}</view>
          </view>
          <view class="all-item-country">{{item.country}} · {{item.categoryText}}</view>
          <view class="all-item-summary">{{item.description}}</view>
          <view wx:if="{{item.budget}}" class="all-item-budget">{{i18n.budget}}：{{item.budget}}</view>
          <view class="all-item-actions">
            <view class="btn btn-primary all-item-btn" catchtap="submitOpportunityIntent" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
              <text>{{i18n.submitIntent}}</text>
            </view>
            <view class="btn btn-secondary all-item-btn" catchtap="askAboutOpp" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
              <text>{{i18n.askQuestion}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{filteredOpportunities.length === 0}}" class="empty-state">
          <text>{{i18n.noResults}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Stories detail modal -->
<view class="modal-mask" wx:if="{{showStoryModal}}" bindtap="closeStoryModal">
  <view class="modal-content stories-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{selectedStory.title}}</text>
      <view class="modal-close" bindtap="closeStoryModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="story-detail-company">{{selectedStory.company}}</view>
      <view class="story-detail-category tag">{{selectedStory.categoryText}}</view>
      <view wx:if="{{selectedStory.media.length > 0}}" class="story-detail-media">
        <image wx:for="{{selectedStory.media}}" wx:key="index" class="story-detail-img" src="{{item.url}}" mode="widthFix"/>
      </view>
      <view class="story-detail-content">{{selectedStory.content}}</view>
      <view class="story-detail-actions">
        <view class="btn btn-primary story-detail-btn" catchtap="askAboutStory" data-id="{{selectedStory.id}}">
          <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
          <text>{{i18n.askQuestion}}</text>
        </view>
        <view class="btn btn-secondary story-detail-btn" catchtap="contactTeam" data-id="{{selectedStory.id}}">
          <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
          <text>{{i18n.contactTeam}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Ask question modal -->
<view class="modal-mask" wx:if="{{showAskModal}}" bindtap="closeAskModal">
  <view class="modal-content ask-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{i18n.askQuestion}}</text>
      <view class="modal-close" bindtap="closeAskModal">×</view>
    </view>
    <view class="modal-body">
      <view class="ask-context">{{i18n.about}}：{{askContext}}</view>
      <textarea class="ask-textarea" placeholder="{{i18n.yourQuestion}}" value="{{askContent}}" bindinput="onAskInput" maxlength="500"/>
      <view class="ask-counter">{{askContent.length}}/500</view>
      <view class="ask-actions">
        <view class="btn btn-secondary ask-btn" catchtap="closeAskModal">{{i18n.cancel}}</view>
        <view class="btn btn-primary ask-btn" catchtap="submitAsk">{{i18n.submit}}</view>
      </view>
    </view>
  </view>
</view>

<!-- Opportunities detail modal -->
<view class="modal-mask" wx:if="{{showOppModal}}" bindtap="closeOppModal">
  <view class="modal-content opp-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{selectedOpp.title}}</text>
      <view class="modal-close" bindtap="closeOppModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="opp-detail-country">{{selectedOpp.country}}</view>
      <view class="opp-detail-tags">
        <text class="tag {{selectedOpp.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{selectedOpp.typeText}}</text>
        <text class="tag">{{selectedOpp.categoryText}}</text>
      </view>
      <view class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.description}}</text>
        <text class="opp-detail-text">{{selectedOpp.description}}</text>
      </view>
      <view class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.requirements}}</text>
        <text class="opp-detail-text">{{selectedOpp.requirements}}</text>
      </view>
      <view wx:if="{{selectedOpp.budget}}" class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.budget}}</text>
        <text class="opp-detail-text">{{selectedOpp.budget}}</text>
      </view>
      <view wx:if="{{selectedOpp.deadline}}" class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.deadline}}</text>
        <text class="opp-detail-text">{{selectedOpp.deadline}}</text>
      </view>
      <view class="opp-detail-actions">
        <view class="btn btn-primary opp-detail-btn" catchtap="submitOpportunityIntent" data-id="{{selectedOpp.id}}">
          <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
          <text>{{i18n.submitIntent}}</text>
        </view>
        <view class="btn btn-secondary opp-detail-btn" catchtap="askAboutOpp" data-id="{{selectedOpp.id}}">
          <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
          <text>{{i18n.askQuestion}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
