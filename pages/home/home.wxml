<!-- pages/home/home.wxml -->
<view class="page-wrap">
  <scroll-view class="scroll" scroll-y>
    <!-- Hero section -->
  <view class="hero">
    <view class="hero-content">
      <view class="corridor">
        <image class="corridor-ico" src="/images/icon-info.svg" mode="aspectFit"/>
        <text>China - Africa</text>
      </view>
      <view class="hero-title">Explore Africa's Opportunities</view>
      <view class="hero-subtitle">Business inspections · Trade cooperation · Investment tours</view>
      <view class="searchbar">
        <image class="search-ico" src="/images/icon-info.svg" mode="aspectFit"/>
        <text class="search-text">Search tours, opportunities, partners…</text>
      </view>
    </view>
  </view>

  <view class="pad">
      <!-- Dual-mode entry -->
      <view class="dual">
        <view class="mode mode-a" bindtap="goTrips">
          <view class="mode-ic">
            <image class="mode-ico" src="/images/icon-airplane.svg" mode="aspectFit"/>
          </view>
          <view class="mode-text">
            <view class="mode-title">African Tours</view>
            <view class="mode-sub">Inspection & delegations</view>
          </view>
          <view class="mode-go">
            <image class="mode-go-ico" src="/images/icon-info.svg" mode="aspectFit"/>
          </view>
        </view>
        <view class="mode mode-b" bindtap="goBusiness">
          <view class="mode-ic">
            <image class="mode-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
          </view>
          <view class="mode-text">
            <view class="mode-title">Business Cooperation</view>
            <view class="mode-sub">Trade · logistics · expo</view>
          </view>
          <view class="mode-go">
            <image class="mode-go-ico" src="/images/icon-info.svg" mode="aspectFit"/>
          </view>
        </view>
      </view>

      <!-- Stats strip -->
      <view class="stats">
        <view class="stat">
          <view class="stat-val">320<text class="stat-plus">+</text></view>
          <view class="stat-lbl">Clients served</view>
        </view>
        <view class="stat">
          <view class="stat-val">6</view>
          <view class="stat-lbl">Countries covered</view>
        </view>
        <view class="stat">
          <view class="stat-val">24<text class="stat-plus">/yr</text></view>
          <view class="stat-lbl">Inspection tours</view>
        </view>
        <view class="stat">
          <view class="stat-val">1,200<text class="stat-plus">m²</text></view>
          <view class="stat-lbl">Expo hall</view>
        </view>
      </view>

      <!-- Featured itineraries -->
      <view class="sec-title">
        <text class="sec-t">Featured itineraries</text>
        <text class="sec-more" bindtap="goTrips">All ›</text>
      </view>
      <view class="dcard" wx:for="{{featuredTrips}}" wx:key="id" bindtap="openTrip" data-id="{{item.id}}">
        <view class="dcard-img" style="background: {{item.gradient}};">
          <view class="badge-ar">
            <image class="badge-ar-ico" src="/images/icon-fire.svg" mode="aspectFit"/>
            <text>AR inspect</text>
          </view>
          <view class="price-tag">
            <text class="price-unit">from </text>
            <text class="price">¥{{item.memberPrice}}</text>
          </view>
        </view>
        <view class="dcard-info">
          <view class="dcard-loc">
            <image class="dcard-loc-ico" src="/images/icon-map.svg" mode="aspectFit"/>
            <text>{{item.country}} · {{item.days}} days</text>
          </view>
          <view class="dcard-title">{{item.title}}</view>
          <view class="tagline">
            <text class="tg" wx:for="{{item.highlights}}" wx:key="index" wx:for-item="h">{{h}}</text>
          </view>
          <view class="dcard-foot">
            <view class="seats">Seats: <text class="seats-bold">{{item.seatsLeft}} left</text> / {{item.seatsTotal}}</view>
            <view class="book-btn">Book now</view>
          </view>
        </view>
      </view>

      <!-- Success stories -->
      <view class="sec-title">
        <text class="sec-t">Success stories</text>
        <text class="sec-more" bindtap="showStoriesModal">Filter ›</text>
      </view>
      <scroll-view class="chips-row" scroll-x>
        <view class="pill {{storyFilter === 'all' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="all">All</view>
        <view class="pill {{storyFilter === 'business' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="business">Business</view>
        <view class="pill {{storyFilter === 'investment' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="investment">Investment</view>
        <view class="pill {{storyFilter === 'tour' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="tour">Inspection</view>
      </scroll-view>
      <view class="story" wx:for="{{filteredStories}}" wx:key="id" bindtap="openStoryDetail" data-id="{{item.id}}">
        <view class="story-top">
          <view class="story-cat">{{item.categoryText}}</view>
          <view class="story-title">{{item.title}}</view>
          <view class="story-summary">{{item.summary}}</view>
        </view>
        <view class="story-bar">
          <view class="story-bar-item">
            <image class="story-bar-ico" src="/images/icon-star.svg" mode="aspectFit"/>
            <text>124</text>
          </view>
          <view class="story-bar-item">
            <image class="story-bar-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
            <text>18 Q&A</text>
          </view>
          <text class="story-bar-sp">Read & ask ›</text>
        </view>
      </view>

      <!-- Business opportunities -->
      <view class="sec-title">
        <text class="sec-t">Business opportunities</text>
        <text class="sec-more" bindtap="showOpportunitiesModal">Post ›</text>
      </view>
      <scroll-view class="chips-row" scroll-x>
        <view class="pill orange {{oppTypeFilter === 'demand' ? 'pill-active orange-active' : ''}}" catchtap="setOppTypeFilter" data-filter="demand">Needs</view>
        <view class="pill {{oppTypeFilter === 'opportunity' ? 'pill-active' : ''}}" catchtap="setOppTypeFilter" data-filter="opportunity">Opportunities</view>
        <view class="pill {{oppCategoryFilter === 'agriculture' ? 'pill-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="agriculture">Agriculture</view>
        <view class="pill {{oppCategoryFilter === 'mining' ? 'pill-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="mining">Mining</view>
      </scroll-view>
      <view class="lc" wx:for="{{filteredOpportunities}}" wx:key="id">
        <view class="lc-row">
          <view class="lc-avatar" style="background: {{item.gradient || 'linear-gradient(135deg,#059669,#0EA5E9)'}};">
            <image class="lc-avatar-ico" src="/images/icon-map.svg" mode="aspectFit"/>
          </view>
          <view class="lc-grow">
            <view class="lc-title">{{item.title}}</view>
            <view class="lc-sub">{{item.type === 'demand' ? 'Buyer' : 'Seller'}} · {{item.country}} · {{item.budget || ''}}</view>
          </view>
          <view class="status-dot st-lead">Need</view>
        </view>
      </view>

      <!-- Business channels -->
      <view class="sec-title">
        <text class="sec-t">Business channels</text>
      </view>
      <view class="channels">
        <view class="ch" bindtap="goBusiness">
          <view class="ch-ic">
            <image class="ch-ico" src="/images/icon-map.svg" mode="aspectFit"/>
          </view>
          <view class="ch-l">Distribution agency</view>
        </view>
        <view class="ch" bindtap="goBusiness">
          <view class="ch-ic">
            <image class="ch-ico" src="/images/icon-store.svg" mode="aspectFit"/>
          </view>
          <view class="ch-l">Exhibition hall entry</view>
        </view>
        <view class="ch" bindtap="goBusiness">
          <view class="ch-ic">
            <image class="ch-ico" src="/images/icon-ship.svg" mode="aspectFit"/>
          </view>
          <view class="ch-l">Logistics / freight</view>
        </view>
      </view>

      <!-- Contact us -->
      <view class="sec-title">
        <text class="sec-t">Contact us</text>
      </view>
      <view class="contact">
        <view class="crow" bindtap="copyWeChat">
          <view class="crow-cc">
            <image class="crow-cc-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
          </view>
          <view class="crow-ct">
            <view class="crow-ct-a">WeChat ID</view>
            <view class="crow-ct-b">TouristaAR_CN</view>
          </view>
          <view class="copy">
            <image class="copy-ico" src="/images/icon-unlock.svg" mode="aspectFit"/>
            <text>Copy</text>
          </view>
        </view>
        <view class="crow" bindtap="copyEmail">
          <view class="crow-cc">
            <image class="crow-cc-ico" src="/images/icon-info.svg" mode="aspectFit"/>
          </view>
          <view class="crow-ct">
            <view class="crow-ct-a">Email</view>
            <view class="crow-ct-b">hello@touristaar.com</view>
          </view>
          <view class="copy">
            <image class="copy-ico" src="/images/icon-unlock.svg" mode="aspectFit"/>
            <text>Copy</text>
          </view>
        </view>
        <view class="crow" bindtap="viewQRCode">
          <view class="crow-cc">
            <image class="crow-cc-ico" src="/images/icon-phone.svg" mode="aspectFit"/>
          </view>
          <view class="crow-ct">
            <view class="crow-ct-a">Official account & QR</view>
            <view class="crow-ct-b">WeCom · Douyin · LinkedIn</view>
          </view>
          <view class="copy copy-blue">
            <image class="copy-ico" src="/images/icon-phone.svg" mode="aspectFit"/>
            <text>View</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<!-- Stories detail modal -->
<view class="modal-mask" wx:if="{{showStoryModal}}" bindtap="closeStoryModal">
  <view class="modal-content stories-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{selectedStory.title}}</text>
      <view class="modal-close" bindtap="closeStoryModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="story-detail-company">{{selectedStory.company}}</view>
      <view class="story-detail-category tag">{{selectedStory.categoryText}}</view>
      <view wx:if="{{selectedStory.media.length > 0}}" class="story-detail-media">
        <image wx:for="{{selectedStory.media}}" wx:key="index" class="story-detail-img" src="{{item.url}}" mode="widthFix"/>
      </view>
      <view class="story-detail-content">{{selectedStory.content}}</view>
      <view class="story-detail-actions">
        <view class="btn btn-primary story-detail-btn" catchtap="askAboutStory" data-id="{{selectedStory.id}}">
          <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
          <text>Ask question</text>
        </view>
        <view class="btn btn-secondary story-detail-btn" catchtap="contactTeam" data-id="{{selectedStory.id}}">
          <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
          <text>Contact team</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Opportunities detail modal -->
<view class="modal-mask" wx:if="{{showOppModal}}" bindtap="closeOppModal">
  <view class="modal-content opp-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{selectedOpp.title}}</text>
      <view class="modal-close" bindtap="closeOppModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="opp-detail-country">{{selectedOpp.country}}</view>
      <view class="opp-detail-tags">
        <text class="tag {{selectedOpp.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{selectedOpp.typeText}}</text>
        <text class="tag">{{selectedOpp.categoryText}}</text>
      </view>
      <view class="opp-detail-section">
        <text class="opp-detail-section-title">Description</text>
        <text class="opp-detail-text">{{selectedOpp.description}}</text>
      </view>
      <view class="opp-detail-section">
        <text class="opp-detail-section-title">Requirements</text>
        <text class="opp-detail-text">{{selectedOpp.requirements}}</text>
      </view>
      <view wx:if="{{selectedOpp.budget}}" class="opp-detail-section">
        <text class="opp-detail-section-title">Budget</text>
        <text class="opp-detail-text">{{selectedOpp.budget}}</text>
      </view>
      <view wx:if="{{selectedOpp.deadline}}" class="opp-detail-section">
        <text class="opp-detail-section-title">Deadline</text>
        <text class="opp-detail-text">{{selectedOpp.deadline}}</text>
      </view>
      <view class="opp-detail-actions">
        <view class="btn btn-primary opp-detail-btn" catchtap="submitOpportunityIntent" data-id="{{selectedOpp.id}}">
          <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
          <text>Submit intent</text>
        </view>
        <view class="btn btn-secondary opp-detail-btn" catchtap="askAboutOpp" data-id="{{selectedOpp.id}}">
          <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
          <text>Ask question</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- All Opportunities / Business Partnership Modal -->
<view class="modal-mask" wx:if="{{showAllOpportunitiesModal}}" bindtap="closeAllOpportunitiesModal">
  <view class="modal-content all-opp-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">Business Cooperation</text>
      <view class="modal-close" bindtap="closeAllOpportunitiesModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="all-opp-contact card">
        <view class="all-opp-contact-title">Contact team</view>
        <view class="all-opp-contact-info">
          <view class="all-opp-contact-row" catchtap="copyWeChat">
            <image class="all-opp-contact-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
            <text>WeChat：touristaar</text>
            <text class="all-opp-contact-copy">Copy</text>
          </view>
          <view class="all-opp-contact-row" catchtap="copyEmail">
            <image class="all-opp-contact-ico" src="/images/icon-info.svg" mode="aspectFit"/>
            <text>Email：hello@touristaar.com</text>
            <text class="all-opp-contact-copy">Copy</text>
          </view>
        </view>
      </view>
      <view class="all-opp-section-title">Opportunities</view>
      <view class="all-list">
        <view class="all-item card" wx:for="{{filteredOpportunities}}" wx:key="id">
          <view class="all-item-header">
            <view class="all-item-title">{{item.title}}</view>
            <view class="tag {{item.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{item.typeText}}</view>
          </view>
          <view class="all-item-country">{{item.country}} · {{item.categoryText}}</view>
          <view class="all-item-summary">{{item.description}}</view>
          <view wx:if="{{item.budget}}" class="all-item-budget">Budget：{{item.budget}}</view>
          <view class="all-item-actions">
            <view class="btn btn-primary all-item-btn" catchtap="submitOpportunityIntent" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/icon-handshake.svg" mode="aspectFit"/>
              <text>Submit intent</text>
            </view>
            <view class="btn btn-secondary all-item-btn" catchtap="askAboutOpp" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
              <text>Ask question</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Ask question modal -->
<view class="modal-mask" wx:if="{{showAskModal}}" bindtap="closeAskModal">
  <view class="modal-content ask-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">Ask question</text>
      <view class="modal-close" bindtap="closeAskModal">×</view>
    </view>
    <view class="modal-body">
      <view class="ask-context">About：{{askContext}}</view>
      <textarea class="ask-textarea" placeholder="Your question" value="{{askContent}}" bindinput="onAskInput" maxlength="500"/>
      <view class="ask-counter">{{askContent.length}}/500</view>
      <view class="ask-actions">
        <view class="btn btn-secondary ask-btn" catchtap="closeAskModal">Cancel</view>
        <view class="btn btn-primary ask-btn" catchtap="submitAsk">Submit</view>
      </view>
    </view>
  </view>
</view>