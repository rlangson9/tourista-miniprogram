<!-- pages/home/home.wxml -->
<view class="page-wrap">
  <scroll-view class="scroll" scroll-y>
    <!-- Hero section -->
  <view class="hero">
    <view class="hero-content">
      <view class="corridor">
        <image class="corridor-ico" src="/images/icon-info.svg" mode="aspectFit"/>
        <text>{{i18n.chinaAfrica}}</text>
      </view>
      <view class="hero-title">{{i18n.heroTitle}}</view>
      <view class="hero-subtitle">{{i18n.heroSub}}</view>
      <view class="searchbar">
        <image class="search-ico" src="/images/icon-search.svg" mode="aspectFit"/>
        <input
          class="search-input"
          value="{{searchText}}"
          placeholder="{{i18n.searchPlaceholder}}"
          placeholder-class="search-ph"
          confirm-type="search"
          bindinput="onSearchInput"
        />
        <view wx:if="{{searchText}}" class="search-clear" catchtap="clearSearch">
          <image class="search-clear-ico" src="/images/icon-close.svg" mode="aspectFit"/>
        </view>
      </view>

      <!-- Live search results -->
      <view wx:if="{{searchText}}" class="search-results">
        <view wx:if="{{!searchResultCount}}" class="search-empty">{{i18n.searchNoResults}}</view>

        <block wx:if="{{searchTrips.length}}">
          <view class="sr-group">{{i18n.searchGroupTrips}}</view>
          <view class="sr-item" wx:for="{{searchTrips}}" wx:key="id" catchtap="openTrip" data-id="{{item.id}}">
            <image class="sr-flag" src="{{item.flagImage}}" mode="aspectFit"/>
            <view class="sr-main">
              <view class="sr-title">{{item.title}}</view>
              <view class="sr-sub">{{item.country}} · ¥{{item.memberPrice}} · {{item.days}}{{i18n.dayUnit}}</view>
            </view>
          </view>
        </block>

        <block wx:if="{{searchStories.length}}">
          <view class="sr-group">{{i18n.searchGroupStories}}</view>
          <view class="sr-item" wx:for="{{searchStories}}" wx:key="id" catchtap="openStoryDetail" data-id="{{item.id}}">
            <view class="sr-badge"><image class="sr-badge-ico" src="/images/icon-star.svg" mode="aspectFit"/></view>
            <view class="sr-main">
              <view class="sr-title">{{item.title}}</view>
              <view class="sr-sub">{{item.company}}</view>
            </view>
          </view>
        </block>

        <block wx:if="{{searchOpportunities.length}}">
          <view class="sr-group">{{i18n.searchGroupOpportunities}}</view>
          <view class="sr-item" wx:for="{{searchOpportunities}}" wx:key="id" catchtap="openOpportunityDetail" data-id="{{item.id}}">
            <view class="sr-badge sr-badge-o"><image class="sr-badge-ico" src="/images/icon-map.svg" mode="aspectFit"/></view>
            <view class="sr-main">
              <view class="sr-title">{{item.title}}</view>
              <view class="sr-sub">{{item.typeText}} · {{item.country}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
    <image class="hero-mascot" src="/images/mascot-touri.png" mode="aspectFit"/>
  </view>

  <view class="pad">
      <!-- Dual-mode entry -->
      <view class="dual">
        <view class="mode mode-a" bindtap="goTrips">
          <view class="mode-ic">
            <image class="mode-ico-sticker" src="/images/mascot-mira.png" mode="aspectFit"/>
          </view>
          <view class="mode-text">
            <view class="mode-title">{{i18n.goToAfrica}}</view>
            <view class="mode-sub">{{i18n.goToAfricaDesc}}</view>
          </view>
        </view>
        <view class="mode mode-b" bindtap="goBusiness">
          <view class="mode-ic">
            <image class="mode-ico-sticker" src="/images/mascot-bao.png" mode="aspectFit"/>
          </view>
          <view class="mode-text">
            <view class="mode-title">{{i18n.doBusiness}}</view>
            <view class="mode-sub">{{i18n.doBusinessDesc}}</view>
          </view>
        </view>
      </view>

      <!-- Stats strip -->
      <view class="stats">
        <view class="stat" wx:for="{{stats}}" wx:key="label">
          <view class="stat-val">{{item.num}}</view>
          <view class="stat-lbl">{{item.label}}</view>
        </view>
      </view>

      <!-- Featured itineraries -->
      <view class="sec-title">
        <text class="sec-t">{{i18n.featuredItineraries}}</text>
        <text class="sec-more" bindtap="goTrips">{{i18n.allMore}}</text>
      </view>
      <view class="dcard" wx:for="{{featuredTrips}}" wx:key="id" bindtap="openTrip" data-id="{{item.id}}">
        <view class="dcard-img" style="background: {{item.gradient}};">
          <image wx:if="{{item.bannerImage}}" class="dcard-bg" src="{{item.bannerImage}}" mode="aspectFill"/>
          <view class="dcard-overlay" style="background: {{item.bannerOverlay}};"></view>
          <image class="dcard-flag" src="{{item.flagImage}}" mode="aspectFit"/>
          <view class="badge-ar">
            <image class="badge-ar-mascot" src="/images/mascot-lens.png" mode="aspectFit"/>
            <text>{{i18n.arInspect}}</text>
          </view>
          <view class="price-tag">
            <text class="price-unit">{{i18n.from}}</text>
            <text class="price">¥{{item.memberPrice}}</text>
          </view>
        </view>
        <view class="dcard-info">
          <view class="dcard-loc">
            <image class="dcard-loc-ico" src="/images/icon-map.svg" mode="aspectFit"/>
            <text>{{item.country}} · {{item.days}} {{i18n.dayUnit}}</text>
          </view>
          <view class="dcard-title">{{item.title}}</view>
          <view class="tagline">
            <text class="tg" wx:for="{{item.highlights}}" wx:key="index" wx:for-item="h">{{h}}</text>
          </view>
          <view class="dcard-foot">
            <view class="seats">{{i18n.seats}}: <text class="seats-bold">{{item.seatsLeft}} {{i18n.left}}</text> / {{item.seatsTotal}}</view>
            <view class="book-btn">{{i18n.bookNow}}</view>
          </view>
        </view>
      </view>

      <!-- Success stories -->
      <view class="sec-title">
        <text class="sec-t">{{i18n.successStories}}</text>
        <text class="sec-more" bindtap="showStoriesModal">{{i18n.filterMore}}</text>
      </view>
      <scroll-view class="chips-row" scroll-x>
        <view class="pill {{storyFilter === 'all' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="all">{{i18n.all}}</view>
        <view class="pill {{storyFilter === 'business' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="business">{{i18n.business}}</view>
        <view class="pill {{storyFilter === 'investment' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="investment">{{i18n.investment}}</view>
        <view class="pill {{storyFilter === 'tour' ? 'pill-active' : ''}}" catchtap="setStoryFilter" data-filter="tour">{{i18n.tour}}</view>
      </scroll-view>
      <view class="story" wx:for="{{filteredStories}}" wx:key="id" bindtap="openStoryDetail" data-id="{{item.id}}">
        <view class="story-top">
          <view class="story-cat">{{item.categoryText}}</view>
          <view class="story-title">{{item.title}}</view>
          <view class="story-summary">{{item.summary}}</view>
        </view>
        <view class="story-bar">
          <view class="story-bar-item">
            <image class="story-bar-ico" src="/images/icon-star.svg" mode="aspectFit"/>
            <text>124</text>
          </view>
          <view class="story-bar-item">
            <image class="story-bar-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
            <text>18 {{i18n.qa}}</text>
          </view>
          <text class="story-bar-sp">{{i18n.readAsk}}</text>
        </view>
      </view>

      <!-- Business opportunities -->
      <view class="sec-title">
        <text class="sec-t">{{i18n.opportunities}}</text>
        <text class="sec-more" bindtap="showOpportunitiesModal">{{i18n.postMore}}</text>
      </view>
      <scroll-view class="chips-row" scroll-x>
        <view class="pill orange {{oppTypeFilter === 'demand' ? 'pill-active orange-active' : ''}}" catchtap="setOppTypeFilter" data-filter="demand">{{i18n.needs}}</view>
        <view class="pill {{oppTypeFilter === 'opportunity' ? 'pill-active' : ''}}" catchtap="setOppTypeFilter" data-filter="opportunity">{{i18n.opportunity}}</view>
        <view class="pill {{oppCategoryFilter === 'agriculture' ? 'pill-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="agriculture">{{i18n.agriculture}}</view>
        <view class="pill {{oppCategoryFilter === 'mining' ? 'pill-active' : ''}}" catchtap="setOppCategoryFilter" data-filter="mining">{{i18n.mining}}</view>
      </scroll-view>
      <view class="lc" wx:for="{{filteredOpportunities}}" wx:key="id">
        <view class="lc-row">
          <view class="lc-avatar" style="background: {{item.gradient || 'linear-gradient(135deg,#059669,#0EA5E9)'}};">
            <image class="lc-avatar-ico" src="/images/icon-map.svg" mode="aspectFit"/>
          </view>
          <view class="lc-grow">
            <view class="lc-title">{{item.title}}</view>
            <view class="lc-sub">{{item.type === 'demand' ? i18n.buyer : i18n.seller}} · {{item.country}} · {{item.budget || ''}}</view>
          </view>
          <view class="status-dot st-lead">{{i18n.need}}</view>
        </view>
      </view>

      <!-- Business channels -->
      <view class="sec-title">
        <text class="sec-t">{{i18n.businessChannels}}</text>
      </view>
      <view class="channels">
        <view class="ch" bindtap="goBusiness">
          <view class="ch-ic">
            <image class="ch-ico" src="/images/icon-map.svg" mode="aspectFit"/>
          </view>
          <view class="ch-l">{{i18n.distributionAgency}}</view>
        </view>
        <view class="ch" bindtap="goBusiness">
          <view class="ch-ic">
            <image class="ch-ico" src="/images/icon-store.svg" mode="aspectFit"/>
          </view>
          <view class="ch-l">{{i18n.exhibitionHall}}</view>
        </view>
        <view class="ch" bindtap="goBusiness">
          <view class="ch-ic">
            <image class="ch-ico" src="/images/icon-ship.svg" mode="aspectFit"/>
          </view>
          <view class="ch-l">{{i18n.logisticsFreight}}</view>
        </view>
      </view>

      <!-- Contact us -->
      <view class="sec-title">
        <text class="sec-t">{{i18n.contactUs}}</text>
      </view>
      <view class="contact">
        <image class="contact-mascot" src="/images/mascot-zola.png" mode="aspectFit"/>
        <view class="crow" bindtap="copyWeChat">
          <view class="crow-cc">
            <image class="crow-cc-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
          </view>
          <view class="crow-ct">
            <view class="crow-ct-a">{{i18n.wechatId}}</view>
            <view class="crow-ct-b">TouristaAR_CN</view>
          </view>
          <view class="copy">
            <image class="copy-ico" src="/images/icon-unlock.svg" mode="aspectFit"/>
            <text>{{i18n.copy}}</text>
          </view>
        </view>
        <view class="crow" bindtap="copyEmail">
          <view class="crow-cc">
            <image class="crow-cc-ico" src="/images/icon-info.svg" mode="aspectFit"/>
          </view>
          <view class="crow-ct">
            <view class="crow-ct-a">{{i18n.email}}</view>
            <view class="crow-ct-b">info@touristaar.com</view>
          </view>
          <view class="copy">
            <image class="copy-ico" src="/images/icon-unlock.svg" mode="aspectFit"/>
            <text>{{i18n.copy}}</text>
          </view>
        </view>
        <view class="crow" bindtap="viewQRCode">
          <view class="crow-cc">
            <image class="crow-cc-ico" src="/images/icon-phone.svg" mode="aspectFit"/>
          </view>
          <view class="crow-ct">
            <view class="crow-ct-a">{{i18n.officialAccount}}</view>
            <view class="crow-ct-b">{{i18n.platforms}}</view>
          </view>
          <view class="copy copy-blue">
            <image class="copy-ico" src="/images/icon-phone.svg" mode="aspectFit"/>
            <text>{{i18n.view}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<!-- Stories detail modal -->
<view class="modal-mask" wx:if="{{showStoryModal}}" bindtap="closeStoryModal">
  <view class="modal-content stories-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{selectedStory.title}}</text>
      <view class="modal-close" bindtap="closeStoryModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="story-detail-company">{{selectedStory.company}}</view>
      <view class="story-detail-category tag">{{selectedStory.categoryText}}</view>
      <view wx:if="{{selectedStory.media.length > 0}}" class="story-detail-media">
        <image wx:for="{{selectedStory.media}}" wx:key="index" class="story-detail-img" src="{{item.url}}" mode="widthFix"/>
      </view>
      <view class="story-detail-content">{{selectedStory.content}}</view>
      <view class="story-detail-actions">
        <view class="btn btn-primary story-detail-btn" catchtap="askAboutStory" data-id="{{selectedStory.id}}">
          <image class="btn-ico" src="/images/mascot-zola.png" mode="aspectFit"/>
          <text>{{i18n.askQuestion}}</text>
        </view>
        <view class="btn btn-secondary story-detail-btn" catchtap="contactTeam" data-id="{{selectedStory.id}}">
          <image class="btn-ico" src="/images/mascot-bao.png" mode="aspectFit"/>
          <text>{{i18n.contactTeam}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Opportunities detail modal -->
<view class="modal-mask" wx:if="{{showOppModal}}" bindtap="closeOppModal">
  <view class="modal-content opp-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{selectedOpp.title}}</text>
      <view class="modal-close" bindtap="closeOppModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="opp-detail-country">{{selectedOpp.country}}</view>
      <view class="opp-detail-tags">
        <text class="tag {{selectedOpp.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{selectedOpp.typeText}}</text>
        <text class="tag">{{selectedOpp.categoryText}}</text>
      </view>
      <view class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.description}}</text>
        <text class="opp-detail-text">{{selectedOpp.description}}</text>
      </view>
      <view class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.requirements}}</text>
        <text class="opp-detail-text">{{selectedOpp.requirements}}</text>
      </view>
      <view wx:if="{{selectedOpp.budget}}" class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.budget}}</text>
        <text class="opp-detail-text">{{selectedOpp.budget}}</text>
      </view>
      <view wx:if="{{selectedOpp.deadline}}" class="opp-detail-section">
        <text class="opp-detail-section-title">{{i18n.deadline}}</text>
        <text class="opp-detail-text">{{selectedOpp.deadline}}</text>
      </view>
      <view class="opp-detail-actions">
        <view class="btn btn-primary opp-detail-btn" catchtap="submitOpportunityIntent" data-id="{{selectedOpp.id}}">
          <image class="btn-ico" src="/images/mascot-bao.png" mode="aspectFit"/>
          <text>{{i18n.submitIntent}}</text>
        </view>
        <view class="btn btn-secondary opp-detail-btn" catchtap="askAboutOpp" data-id="{{selectedOpp.id}}">
          <image class="btn-ico" src="/images/mascot-zola.png" mode="aspectFit"/>
          <text>{{i18n.askQuestion}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- All Opportunities / Business Partnership Modal -->
<view class="modal-mask" wx:if="{{showAllOpportunitiesModal}}" bindtap="closeAllOpportunitiesModal">
  <view class="modal-content all-opp-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{i18n.businessChannel}}</text>
      <view class="modal-close" bindtap="closeAllOpportunitiesModal">×</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="all-opp-contact card">
        <view class="all-opp-contact-title">{{i18n.contactTeam}}</view>
        <view class="all-opp-contact-info">
          <view class="all-opp-contact-row" catchtap="copyWeChat">
            <image class="all-opp-contact-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
            <text>{{i18n.weChat}}：touristaar</text>
            <text class="all-opp-contact-copy">{{i18n.copy}}</text>
          </view>
          <view class="all-opp-contact-row" catchtap="copyEmail">
            <image class="all-opp-contact-ico" src="/images/icon-info.svg" mode="aspectFit"/>
            <text>{{i18n.email}}：info@touristaar.com</text>
            <text class="all-opp-contact-copy">{{i18n.copy}}</text>
          </view>
        </view>
      </view>
      <view class="all-opp-section-title">{{i18n.opportunities}}</view>
      <view class="all-list">
        <view class="all-item card" wx:for="{{filteredOpportunities}}" wx:key="id">
          <view class="all-item-header">
            <view class="all-item-title">{{item.title}}</view>
            <view class="tag {{item.type === 'demand' ? 'tag-secondary' : 'tag-primary'}}">{{item.typeText}}</view>
          </view>
          <view class="all-item-country">{{item.country}} · {{item.categoryText}}</view>
          <view class="all-item-summary">{{item.description}}</view>
          <view wx:if="{{item.budget}}" class="all-item-budget">{{i18n.budget}}：{{item.budget}}</view>
          <view class="all-item-actions">
            <view class="btn btn-primary all-item-btn" catchtap="submitOpportunityIntent" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/mascot-bao.png" mode="aspectFit"/>
              <text>{{i18n.submitIntent}}</text>
            </view>
            <view class="btn btn-secondary all-item-btn" catchtap="askAboutOpp" data-id="{{item.id}}">
              <image class="btn-ico" src="/images/mascot-zola.png" mode="aspectFit"/>
              <text>{{i18n.askQuestion}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Ask question modal -->
<view class="modal-mask" wx:if="{{showAskModal}}" bindtap="closeAskModal">
  <view class="modal-content ask-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">{{i18n.askQuestion}}</text>
      <view class="modal-close" bindtap="closeAskModal">×</view>
    </view>
    <view class="modal-body">
      <view class="ask-context">{{i18n.about}}：{{askContext}}</view>
      <textarea class="ask-textarea" placeholder="{{i18n.yourQuestion}}" value="{{askContent}}" bindinput="onAskInput" maxlength="500"/>
      <view class="ask-counter">{{askContent.length}}/500</view>
      <view class="ask-actions">
        <view class="btn btn-secondary ask-btn" catchtap="closeAskModal">{{i18n.cancel}}</view>
        <view class="btn btn-primary ask-btn" catchtap="submitAsk">{{i18n.submit}}</view>
      </view>
    </view>
  </view>
</view>
