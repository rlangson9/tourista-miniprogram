/* pages/home/home.wxss */

.scroll { position: absolute; inset: 0; overflow-y: auto; padding-bottom: 40rpx; }
.pad { padding: 0 32rpx; }

/* Hero section */
.hero {
  background: linear-gradient(150deg, var(--blue) 0%, var(--blue-600) 50%, #0F172A 100%);
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  position: relative;
  overflow: hidden;
  border-radius: 0 0 60rpx 60rpx;
}
.hero::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255,140,66,.15) 0%, transparent 70%);
  border-radius: 50%;
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(59,130,246,.2) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-content { position: relative; z-index: 1; }
.hero-mascot {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 200rpx;
  height: 200rpx;
  z-index: 1;
  opacity: 0.85;
  pointer-events: none;
}
.corridor {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,.2);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}
.corridor-ico { width: 24rpx; height: 24rpx; }
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
  margin-bottom: 12rpx;
}
.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,.8);
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.searchbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  background: rgba(255,255,255,.95);
  border-radius: 28rpx;
  padding: 0 28rpx;
  color: var(--gray-400);
  font-size: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.15);
}
.search-ico { width: 36rpx; height: 36rpx; flex: none; opacity: 0.6; }
.search-text { font-size: 26rpx; }

/* Dual-mode cards */
.dual { 
  display: grid; 
  grid-template-columns: 1fr 1fr; 
  gap: 20rpx; 
  margin-top: 8rpx;
}
.mode {
  border-radius: var(--radius);
  padding: 28rpx;
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  transition: transform var(--transition-normal);
}
.mode:active { transform: scale(0.98); }
.mode-a { 
  background: linear-gradient(150deg, #1E40AF, #3B5BDB); 
}
.mode-b { 
  background: linear-gradient(150deg, #E9721F, #FF8C42); 
}
.mode::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(255,255,255,.15) 0%, transparent 70%);
  border-radius: 50%;
}
.mode-ic {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,.14);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(6rpx);
}
.mode-ico { width: 40rpx; height: 40rpx; }
.mode-ico-sticker { width: 76rpx; height: 76rpx; pointer-events: none; }
.mode-text { margin-top: 16rpx; position: relative; z-index: 1; }
.mode-title { font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.mode-sub { font-size: 21rpx; opacity: .9; margin-top: 6rpx; }
.mode-go { position: absolute; right: 20rpx; bottom: 20rpx; z-index: 2; }
.mode-go-ico { width: 32rpx; height: 32rpx; transform: rotate(90deg); opacity: 0.8; }
.mode-go-sticker { width: 80rpx; height: 80rpx; pointer-events: none; opacity: 0.95; }
.mode-mascot {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.25;
  pointer-events: none;
  z-index: 0;
}

/* Stats strip */
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx 16rpx;
  margin-top: 24rpx;
  position: relative;
}
.stats::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--blue), transparent);
  border-radius: 2rpx;
}
.stat { text-align: center; }
.stat-val { font-size: 36rpx; font-weight: 800; color: var(--blue); }
.stat-plus { font-size: 20rpx; }
.stat-lbl { font-size: 19rpx; color: var(--gray); margin-top: 6rpx; line-height: 1.25; }

/* Section title */
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}
.sec-t { 
  font-size: 32rpx; 
  font-weight: 700; 
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sec-t::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--orange), var(--blue));
  border-radius: 3rpx;
}

/* Featured cards */
.dcard {
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
  transition: transform var(--transition-fast), box-shadow var(--transition-normal);
}
.dcard:active { 
  transform: translateY(-4rpx); 
  box-shadow: var(--shadow-lg);
}
.dcard-img {
  height: 240rpx;
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx;
  overflow: hidden;
}
.dcard-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.dcard-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}
.dcard-sticker {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  width: 72rpx;
  height: 72rpx;
  z-index: 3;
  pointer-events: none;
  opacity: 0.95;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,.25));
}
.dcard-flag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 140rpx;
  height: 70rpx;
  border-radius: 8rpx;
  opacity: 0.95;
  z-index: 3;
  pointer-events: none;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.2);
}
.badge-ar {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,.92);
  color: var(--blue);
  font-size: 20rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  position: relative;
  z-index: 3;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.15);
}
.badge-ar-ico { width: 24rpx; height: 24rpx; }
.badge-ar-mascot { width: 40rpx; height: 40rpx; pointer-events: none; }
.price-tag { 
  position: absolute; 
  right: 20rpx; 
  bottom: 20rpx;
  background: rgba(15,23,42,.78);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(6rpx);
  z-index: 3;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.3);
}
.price-unit { font-size: 20rpx; font-weight: 600; opacity: .88; margin-right: 4rpx; }
.price { font-size: 28rpx; }
.dcard-info { padding: 24rpx; }
.dcard-loc {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--gray);
  font-weight: 600;
}
.dcard-loc-ico { width: 26rpx; height: 26rpx; }
.dcard-title { font-size: 30rpx; font-weight: 700; margin: 8rpx 0 12rpx; color: var(--ink); }
.tagline { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.tg {
  font-size: 19rpx;
  font-weight: 700;
  color: var(--blue);
  background: var(--blue-50);
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
}
.dcard-foot { display: flex; align-items: center; justify-content: space-between; }
.seats { font-size: 22rpx; color: var(--gray); font-weight: 600; }
.seats-bold { color: var(--orange-600); }
.book-btn {
  background: linear-gradient(135deg, var(--orange-600), var(--orange));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,140,66,.25);
}

/* Chips row */
.chips-row { display: flex; gap: 14rpx; overflow-x: auto; padding: 8rpx 0; }
.chips-row::-webkit-scrollbar { display: none; }
.pill {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  color: var(--gray);
  transition: all var(--transition-fast);
}
.pill:active { transform: scale(0.96); }
.pill-active { 
  background: linear-gradient(135deg, var(--blue), var(--blue-600)); 
  color: #fff; 
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(30,64,175,.3);
}
.pill.orange.orange-active { 
  background: linear-gradient(135deg, var(--orange-600), var(--orange)); 
  color: #fff; 
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(255,140,66,.3);
}

/* Success story card */
.story {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  margin-bottom: 20rpx;
  transition: transform var(--transition-fast);
}
.story:active { transform: scale(0.99); }
.story-top { padding: 28rpx; }
.story-cat {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--orange-600);
}
.story-title { font-size: 28rpx; font-weight: 700; margin: 10rpx 0 12rpx; color: var(--ink); }
.story-summary { font-size: 24rpx; color: var(--gray); line-height: 1.6; }
.story-bar {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 20rpx 28rpx;
  border-top: 2rpx solid var(--line);
  color: var(--gray);
  font-size: 22rpx;
}
.story-bar-item { display: flex; align-items: center; gap: 10rpx; }
.story-bar-ico { width: 28rpx; height: 28rpx; }
.story-bar-sp { margin-left: auto; color: var(--blue); font-weight: 700; }

/* Opportunity cards */
.lc {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin-bottom: 20rpx;
  transition: transform var(--transition-fast);
}
.lc:active { transform: scale(0.99); }
.lc-row { display: flex; align-items: center; gap: 24rpx; }
.lc-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.08);
}
.lc-avatar-ico { width: 44rpx; height: 44rpx; }
.lc-grow { flex: 1; min-width: 0; }
.lc-title { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.lc-sub { font-size: 22rpx; color: var(--gray); margin-top: 6rpx; }

/* Business channels */
.channels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; margin-top: 16rpx; }
.ch {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx 16rpx;
  text-align: center;
  transition: transform var(--transition-fast);
}
.ch:active { transform: scale(0.98); }
.ch-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--blue-50), var(--blue-100));
}
.ch-ico { width: 44rpx; height: 44rpx; }
.ch-l { font-size: 22rpx; font-weight: 600; line-height: 1.3; color: var(--ink); }

/* Contact section */
.contact {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  margin-bottom: 40rpx;
  position: relative;
}
.contact-mascot {
  position: absolute;
  right: 24rpx;
  top: -60rpx;
  width: 140rpx;
  height: 140rpx;
  z-index: 2;
  pointer-events: none;
}
.crow {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx;
  border-bottom: 2rpx solid var(--line);
  transition: background var(--transition-fast);
}
.crow:active { background: var(--bg-secondary); }
.crow:last-child { border: none; }
.crow-cc {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--blue-50);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.crow-cc-ico { width: 36rpx; height: 36rpx; }
.crow-ct { flex: 1; }
.crow-ct-a { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.crow-ct-b { font-size: 22rpx; color: var(--gray); }
.copy {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--orange-600);
  background: var(--orange-50);
  padding: 12rpx 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.copy-ico { width: 26rpx; height: 26rpx; }
.copy-blue { background: var(--blue-50); color: var(--blue); }

/* Modals */
.modal-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  max-height: 85vh;
  animation: slideUp var(--transition-normal);
}
.modal-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid var(--line);
}
.modal-title { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.modal-close { font-size: 52rpx; color: var(--gray); line-height: 1; }
.modal-body { padding: 32rpx; max-height: 60vh; }

/* Story detail */
.story-detail-company { font-size: 26rpx; color: var(--gray); }
.story-detail-category { margin-top: 12rpx; }
.story-detail-media { margin-top: 20rpx; }
.story-detail-img { width: 100%; margin-bottom: 12rpx; border-radius: 20rpx; }
.story-detail-content { font-size: 26rpx; line-height: 1.8; margin-top: 20rpx; color: var(--ink-lighter); }
.story-detail-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.story-detail-btn { flex: 1; }

/* Opportunity detail */
.opp-detail-country { font-size: 26rpx; color: var(--gray); }
.opp-detail-tags { display: flex; gap: 12rpx; margin-top: 12rpx; }
.opp-detail-section { margin-top: 24rpx; }
.opp-detail-section-title { font-size: 26rpx; font-weight: 700; margin-bottom: 12rpx; color: var(--ink); }
.opp-detail-text { font-size: 26rpx; line-height: 1.8; color: var(--gray); }
.opp-detail-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.opp-detail-btn { flex: 1; }

/* All opportunities */
.all-opp-contact { margin-bottom: 24rpx; }
.all-opp-contact-title { font-size: 28rpx; font-weight: 700; padding-bottom: 20rpx; color: var(--ink); }
.all-opp-contact-info { padding: 0 8rpx; }
.all-opp-contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.all-opp-contact-row:last-child { border: none; }
.all-opp-contact-ico { width: 40rpx; height: 40rpx; }
.all-opp-contact-copy { margin-left: auto; color: var(--orange-600); font-weight: 700; }
.all-opp-section-title { font-size: 28rpx; font-weight: 700; margin: 24rpx 0 16rpx; color: var(--ink); }
.all-list { padding-bottom: 40rpx; }
.all-item { padding: 24rpx; margin-bottom: 16rpx; }
.all-item-header { display: flex; align-items: center; justify-content: space-between; }
.all-item-title { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.all-item-country { font-size: 24rpx; color: var(--gray); margin-top: 8rpx; }
.all-item-summary { font-size: 24rpx; line-height: 1.6; margin-top: 12rpx; color: var(--ink-lighter); }
.all-item-budget { font-size: 24rpx; color: var(--gray); margin-top: 8rpx; }
.all-item-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.all-item-btn { flex: 1; height: 84rpx; }

/* Ask modal */
.ask-modal { max-height: 70vh; }
.ask-context { font-size: 24rpx; color: var(--gray); margin-bottom: 20rpx; }
.ask-textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 20rpx;
  font-size: 26rpx;
}
.ask-counter { text-align: right; font-size: 22rpx; color: var(--gray); margin-top: 8rpx; }
.ask-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.ask-btn { flex: 1; }