/* pages/trips/trips.wxss */

.scroll { position: absolute; inset: 0; overflow-y: auto; padding-bottom: 40rpx; }
.pad { padding: 0 32rpx; }

/* Mira mascot guide hero */
.trips-hero {
  position: relative;
  margin: 20rpx 32rpx 8rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, var(--blue-50), var(--green-100));
  border-radius: var(--radius);
  overflow: hidden;
  min-height: 140rpx;
}
.trips-hero::before {
  content: '';
  position: absolute;
  top: -40%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(30,64,175,.08) 0%, transparent 70%);
  border-radius: 50%;
}
.trips-mascot {
  position: absolute;
  right: 16rpx;
  bottom: 0;
  width: 140rpx;
  height: 140rpx;
  opacity: 0.85;
  pointer-events: none;
  z-index: 1;
}

/* Chips row */
.chips-row { display: flex; gap: 14rpx; overflow-x: auto; padding: 20rpx 32rpx 10rpx; }
.chips-row::-webkit-scrollbar { display: none; }
.pill {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  color: var(--gray);
  transition: all var(--transition-fast);
}
.pill:active { transform: scale(0.96); }
.pill-active { 
  background: linear-gradient(135deg, var(--blue), var(--blue-600)); 
  color: #fff; 
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(30,64,175,.3);
}

/* Trip cards */
.trip { 
  margin: 0 32rpx 24rpx; 
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: transform var(--transition-fast), box-shadow var(--transition-normal);
}
.trip:active { 
  transform: translateY(-4rpx); 
  box-shadow: var(--shadow-lg);
}
.trip-banner { 
  height: 240rpx; 
  color: #fff; 
  padding: 20rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.trip-banner-flag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 160rpx;
  height: 80rpx;
  border-radius: 8rpx;
  opacity: 0.95;
  z-index: 1;
  pointer-events: none;
}
.trip-banner::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,.15) 0%, transparent 70%);
  border-radius: 50%;
}
.badge-ar {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,.9);
  color: var(--blue);
  font-size: 20rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}
.badge-ar-ico { width: 24rpx; height: 24rpx; }
.price-tag { 
  position: absolute; 
  right: 20rpx; 
  bottom: 20rpx;
  background: rgba(15,23,42,.75);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}
.trip-body { padding: 24rpx; }
.trip-loc {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--gray);
  font-weight: 600;
}
.trip-loc-ico { width: 26rpx; height: 26rpx; }
.trip-title { font-size: 30rpx; font-weight: 700; margin: 8rpx 0 12rpx; color: var(--ink); }
.trip-tags { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.tg {
  font-size: 19rpx;
  font-weight: 700;
  color: var(--blue);
  background: var(--blue-50);
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
}
.trip-foot { display: flex; align-items: center; justify-content: space-between; }
.rating { display: flex; align-items: center; gap: 6rpx; }
.rating-ico { width: 28rpx; height: 28rpx; }
.rating-num { font-size: 24rpx; font-weight: 700; color: var(--orange-600); margin-left: 6rpx; }
.rating-count { font-size: 22rpx; color: var(--gray); margin-left: 4rpx; }
.book-btn {
  background: linear-gradient(135deg, var(--orange-600), var(--orange));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,140,66,.25);
}

/* Past tours */
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.past { 
  margin: 0 32rpx 24rpx; 
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx; 
  display: flex; 
  gap: 24rpx; 
  align-items: center;
  transition: transform var(--transition-fast);
}
.past:active { transform: scale(0.99); }
.past-thumb {
  width: 104rpx; 
  height: 104rpx; 
  border-radius: 28rpx; 
  flex-shrink: 0;
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.1);
}
.past-info { flex: 1; }
.past-t { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.past-d { font-size: 22rpx; color: var(--gray); margin-top: 6rpx; }
.past-tags { margin-top: 12rpx; display: flex; gap: 12rpx; flex-wrap: wrap; }
.past-media {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}
.past-media-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.past-media-more {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--blue-50);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--blue);
  font-size: 24rpx;
  font-weight: 700;
}

/* empty state */
.empty { margin: 40rpx 32rpx; padding: 60rpx 40rpx; text-align: center; }
.empty-ico { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto; background: var(--bg-secondary); border-radius: 50%; }
.empty-img { width: 80rpx; height: 80rpx; opacity: 0.5; }
.empty-t { font-size: 32rpx; font-weight: 700; margin-top: 24rpx; color: var(--ink); }
.empty-d { font-size: 24rpx; color: var(--gray); line-height: 1.7; margin-top: 14rpx; }
.empty-btn { padding: 24rpx 0; margin-top: 32rpx; }

/* Custom Modal */
.modal-overlay {
  position: fixed; 
  top: 0; 
  left: 0; 
  right: 0; 
  bottom: 0;
  background: rgba(15,23,42,.55); 
  z-index: 1000;
  display: flex; 
  align-items: center; 
  justify-content: center;
  padding: 40rpx;
  animation: fadeIn var(--transition-fast);
}

.modal-content {
  width: 100%; 
  max-width: 640rpx;
  background: #fff; 
  border-radius: 32rpx; 
  overflow: hidden;
  animation: scaleIn var(--transition-normal);
}

.modal-header {
  display: flex; 
  align-items: center; 
  justify-content: space-between;
  padding: 32rpx; 
  border-bottom: 2rpx solid var(--line);
}

.modal-title {
  font-size: 34rpx; 
  font-weight: 700; 
  color: var(--ink);
}

.modal-close {
  width: 56rpx; 
  height: 56rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center;
  font-size: 48rpx; 
  color: var(--gray); 
}

.modal-body {
  padding: 32rpx;
}

.contact-info {
  margin-bottom: 32rpx;
}

.contact-item {
  display: flex; 
  align-items: center; 
  margin-bottom: 18rpx;
}

.contact-label {
  font-size: 24rpx; 
  color: var(--gray); 
  width: 140rpx; 
  flex-shrink: 0;
}

.contact-value {
  font-size: 26rpx; 
  color: var(--ink); 
  flex: 1;
}

.qr-section {
  text-align: center;
  padding: 20rpx;
  background: var(--bg-secondary);
  border-radius: 20rpx;
}

.qr-title {
  font-size: 26rpx; 
  font-weight: 700; 
  color: var(--ink); 
  display: block; 
  margin-bottom: 20rpx;
}

.qr-code {
  width: 280rpx; 
  height: 280rpx; 
  margin: 0 auto; 
  display: block; 
  border-radius: 16rpx;
  background: #fff;
  padding: 12rpx;
}

.qr-desc {
  font-size: 22rpx; 
  color: var(--gray); 
  display: block; 
  margin-top: 16rpx;
}

.modal-footer {
  padding: 24rpx 32rpx 36rpx;
}