<!-- pages/profile/profile.wxml -->
<view class="page-wrap">

  <!-- Profile header -->
  <view class="pr-hero">
    <view class="grid-lines"></view>
    <view class="pr-avatar"><image class="pr-avatar-ico" src="/images/icon-user.svg" mode="aspectFit"/></view>
    <view class="flex1">
      <view class="pr-name">
        {{userName || (user.loggedIn ? i18n.user : i18n.guest)}}
        <text wx:if="{{user.isMember}}" class="tag pr-member"><image class="pr-tag-ico" src="/images/icon-crown.svg" mode="aspectFit"/> {{i18n.member}}</text>
      </view>
      <view class="pr-company">{{userCompany || (user.loggedIn ? '' : i18n.loginTip)}}</view>
    </view>
  </view>

  <!-- Stats -->
  <view class="card pr-stats">
    <view class="pr-stat" bindtap="goOrders">
      <view class="pr-stat-num">{{tripCount}}</view>
      <view class="pr-stat-lbl">{{i18n.trips}}</view>
    </view>
    <view class="pr-stat" bindtap="goOrders">
      <view class="pr-stat-num">{{applCount}}</view>
      <view class="pr-stat-lbl">{{i18n.applications}}</view>
    </view>
    <view class="pr-stat">
      <view class="pr-stat-num">¥{{savedText}}</view>
      <view class="pr-stat-lbl">{{i18n.saved}}</view>
    </view>
  </view>

  <!-- Menu group 1 -->
  <view class="card pr-menu">
    <view class="pr-row" bindtap="goOrders">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-clipboard.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.myOrders}}</text><text class="pr-row-arr">›</text>
    </view>
    <view class="pr-row" bindtap="goApplications">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-handshake.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.cooperationProgress}}</text>
      <text class="pr-row-note">{{i18n.advisorConnected}} ›</text>
    </view>
    <view class="pr-row">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-crown.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.memberBenefits}}</text><text class="pr-row-arr">›</text>
    </view>
    <view class="pr-row pr-row-last">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-scroll.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.pastTrips}}</text><text class="pr-row-arr">›</text>
    </view>
  </view>

  <!-- Menu group 2 -->
  <view class="card pr-menu">
    <view class="pr-row" bindtap="contactAdvisor">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-chat.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.contactAdvisor}}</text>
      <text class="pr-row-note">{{i18n.wechat1on1}} ›</text>
    </view>
    <view class="pr-row" bindtap="downloadApp">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-phone.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.downloadApp}}</text><text class="pr-row-arr">›</text>
      <image class="dl-mascot" src="/images/mascot-lens.png" mode="aspectFit"/>
    </view>
    <view class="pr-row" bindtap="switchLanguage">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-info.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.languageSwitch}}</text>
      <text class="pr-row-note">{{langDisplay}} ›</text>
    </view>
    <view class="pr-row pr-row-last" bindtap="about">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-info.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.aboutUs}}</text><text class="pr-row-arr">›</text>
      <image class="about-mascot" src="/images/mascot-zola.png" mode="aspectFit"/>
    </view>
  </view>

  <!-- Login/Logout -->
  <view class="card pr-menu" wx:if="{{!user.loggedIn}}">
    <view class="pr-row pr-row-primary" bindtap="showLoginModal">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-user.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.login}}</text><text class="pr-row-arr">›</text>
    </view>
  </view>
  <view class="card pr-menu" wx:else>
    <view class="pr-row pr-row-danger" bindtap="handleLogout">
      <text class="pr-row-ico"><image class="pr-row-img" src="/images/icon-logout.svg" mode="aspectFit"/></text><text class="pr-row-t">{{i18n.logout}}</text><text class="pr-row-arr">›</text>
    </view>
  </view>

  <view class="pr-footer">{{footerText}}</view>

</view>

<!-- Login Modal -->
<view class="modal-mask" wx:if="{{showLoginModal}}" bindtap="closeLoginModal">
  <view class="modal-content login-modal" catchtap="noop">
    <!-- Brand header -->
    <view class="login-brand">
      <image class="login-brand-mascot" src="/images/mascot-touri.png" mode="aspectFit"/>
      <view class="login-brand-title">{{i18n.loginTitle}}</view>
      <view class="login-brand-sub">{{i18n.loginSubtitle}}</view>
    </view>
    
    <view class="login-close" bindtap="closeLoginModal">×</view>

    <!-- WeChat login (primary) -->
    <view class="login-section">
      <view class="login-btn-wechat" bindtap="loginWithWeChat">
        <image class="login-btn-ico" src="/images/icon-chat.svg" mode="aspectFit"/>
        <text>{{i18n.wechatLogin}}</text>
      </view>
      <view class="login-btn-desc">{{i18n.wechatLoginDesc}}</view>
    </view>

    <!-- Divider -->
    <view class="login-divider">
      <view class="login-divider-line"></view>
      <text class="login-divider-text">{{i18n.or}}</text>
      <view class="login-divider-line"></view>
    </view>

    <!-- Phone login -->
    <view class="login-section">
      <view class="login-phone-toggle" bindtap="showPhoneLogin">
        <image class="login-btn-ico-sm" src="/images/icon-phone.svg" mode="aspectFit"/>
        <text>{{i18n.phoneLogin}}</text>
        <text class="login-toggle-arrow {{showPhoneForm ? 'arrow-rotated' : ''}}">›</text>
      </view>
      
      <!-- Phone form (expandable) -->
      <view class="login-form" wx:if="{{showPhoneForm}}">
        <view class="login-input-wrap">
          <image class="login-input-ico" src="/images/icon-phone.svg" mode="aspectFit"/>
          <input class="login-input" placeholder="{{i18n.phone}}" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11"/>
        </view>
        <view class="login-input-wrap">
          <image class="login-input-ico" src="/images/icon-scroll.svg" mode="aspectFit"/>
          <input class="login-input" placeholder="{{i18n.verificationCode}}" value="{{code}}" bindinput="onCodeInput" type="number" maxlength="6"/>
          <view class="login-code-btn {{countdown > 0 ? 'code-btn-disabled' : ''}}" bindtap="sendCode">
            {{countdown > 0 ? countdown + i18n.countdown : (codeSent ? i18n.resend : i18n.getCode)}}
          </view>
        </view>
        <view class="btn btn-primary login-submit-btn" bindtap="loginWithPhone">
          {{i18n.login}}
        </view>
      </view>
    </view>

    <!-- Privacy note -->
    <view class="login-privacy">{{i18n.privacyNote}}</view>
  </view>
</view>

<!-- About Modal -->
<view class="modal-mask about-modal" wx:if="{{showAbout}}" bindtap="closeAbout">
  <view class="about-sheet" catchtap="noop">

    <!-- Close button -->
    <view class="about-close" bindtap="closeAbout">
      <image class="about-close-ico" src="/images/icon-close.svg" mode="aspectFit"/>
    </view>

    <!-- Hero / brand header -->
    <view class="about-hero">
      <view class="about-hero-grid"></view>
      <image class="about-hero-mascot" src="/images/mascot-zola.png" mode="aspectFit"/>
      <view class="about-hero-brand">TOURISTA AR</view>
      <view class="about-hero-title">{{i18n.aboutTitle}}</view>
      <view class="about-hero-sub">{{i18n.aboutSubtitle}}</view>
    </view>

    <!-- Scrollable body -->
    <scroll-view scroll-y class="about-body" enhanced show-scrollbar="{{false}}">

      <!-- Company description -->
      <view class="about-section">
        <view class="about-p">{{i18n.aboutDesc1}}</view>
        <view class="about-p about-p-mute">{{i18n.aboutDesc2}}</view>
      </view>

      <!-- Mission card -->
      <view class="about-mission">
        <view class="about-mission-ico">
          <image class="about-mission-img" src="/images/icon-diamond.svg" mode="aspectFit"/>
        </view>
        <view class="about-mission-title">{{i18n.ourMission}}</view>
        <view class="about-mission-text">{{i18n.ourMissionText}}</view>
      </view>

      <!-- Team section -->
      <view class="about-section">
        <view class="about-sec-head">
          <view class="about-sec-ico"><image class="about-sec-img" src="/images/icon-team.svg" mode="aspectFit"/></view>
          <view class="about-sec-title">{{i18n.ourTeam}}</view>
        </view>
        <view class="team-grid">
          <view class="team-card" wx:for="{{teamMembers}}" wx:key="id">
            <view class="team-photo-wrap">
              <image wx:if="{{!item.photoFailed}}" class="team-photo" src="{{item.photo}}" mode="aspectFill" data-id="{{item.id}}" binderror="onTeamPhotoError"/>
              <view wx:else class="team-initial">{{item.initial}}</view>
            </view>
            <view class="team-name">{{item.name}}</view>
            <view class="team-role">{{item.role}}</view>
            <view wx:if="{{item.bio}}" class="team-bio">{{item.bio}}</view>
          </view>
        </view>
      </view>

      <!-- Contact section -->
      <view class="about-section">
        <view class="about-sec-head">
          <view class="about-sec-ico"><image class="about-sec-img" src="/images/icon-phone.svg" mode="aspectFit"/></view>
          <view class="about-sec-title">{{i18n.contactUs}}</view>
        </view>

        <view class="contact-card">

          <view class="contact-row" bindtap="copyContact" data-text="{{i18n.addressValue}}" data-label="{{i18n.addressLabel}}">
            <view class="contact-ico"><image class="contact-img" src="/images/icon-pin.svg" mode="aspectFit"/></view>
            <view class="contact-info">
              <view class="contact-lbl">{{i18n.addressLabel}}</view>
              <view class="contact-val">{{i18n.addressValue}}</view>
            </view>
            <view class="contact-act">
              <image class="contact-act-img" src="/images/icon-copy.svg" mode="aspectFit"/>
            </view>
          </view>

          <view class="contact-row" bindtap="callHotline" data-text="{{i18n.hotlineValue}}" data-label="{{i18n.hotlineLabel}}">
            <view class="contact-ico"><image class="contact-img" src="/images/icon-phone.svg" mode="aspectFit"/></view>
            <view class="contact-info">
              <view class="contact-lbl">{{i18n.hotlineLabel}}</view>
              <view class="contact-val">{{i18n.hotlineValue}}</view>
            </view>
            <view class="contact-act">
              <image class="contact-act-img" src="/images/icon-call.svg" mode="aspectFit"/>
            </view>
          </view>

          <view class="contact-row" bindtap="copyContact" data-text="{{i18n.emailValue}}" data-label="{{i18n.emailLabel}}">
            <view class="contact-ico"><image class="contact-img" src="/images/icon-mail.svg" mode="aspectFit"/></view>
            <view class="contact-info">
              <view class="contact-lbl">{{i18n.emailLabel}}</view>
              <view class="contact-val">{{i18n.emailValue}}</view>
            </view>
            <view class="contact-act">
              <image class="contact-act-img" src="/images/icon-copy.svg" mode="aspectFit"/>
            </view>
          </view>

          <view class="contact-row" bindtap="copyContact" data-text="{{'https://' + i18n.websiteValue}}" data-label="{{i18n.websiteLabel}}">
            <view class="contact-ico"><image class="contact-img" src="/images/icon-web.svg" mode="aspectFit"/></view>
            <view class="contact-info">
              <view class="contact-lbl">{{i18n.websiteLabel}}</view>
              <view class="contact-val">{{i18n.websiteValue}}</view>
            </view>
            <view class="contact-act">
              <image class="contact-act-img" src="/images/icon-copy.svg" mode="aspectFit"/>
            </view>
          </view>

          <view class="contact-row" bindtap="copyContact" data-text="{{i18n.wechatValue}}" data-label="{{i18n.wechatLabel}}">
            <view class="contact-ico"><image class="contact-img" src="/images/icon-chat.svg" mode="aspectFit"/></view>
            <view class="contact-info">
              <view class="contact-lbl">{{i18n.wechatLabel}}</view>
              <view class="contact-val">{{i18n.wechatValue}}</view>
            </view>
            <view class="contact-act">
              <image class="contact-act-img" src="/images/icon-copy.svg" mode="aspectFit"/>
            </view>
          </view>

          <view class="contact-row contact-row-last">
            <view class="contact-ico"><image class="contact-img" src="/images/icon-clock.svg" mode="aspectFit"/></view>
            <view class="contact-info">
              <view class="contact-lbl">{{i18n.workHoursLabel}}</view>
              <view class="contact-val">{{i18n.workHoursValue}}</view>
            </view>
          </view>

        </view>
      </view>

      <!-- Legal footer -->
      <view class="about-legal">
        <view class="about-legal-line">Tourista AR</view>
        <view class="about-copy">© 2026 Tourista AR · All Rights Reserved</view>
      </view>
    </scroll-view>
  </view>
</view>
