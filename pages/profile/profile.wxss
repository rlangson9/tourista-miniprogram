/* pages/profile/profile.wxss */

/* Hero */
.pr-hero {
  background: linear-gradient(135deg, var(--blue), #3B5BDB);
  color: #fff;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}
.grid-lines {
  position: absolute;
  inset: 0;
  opacity: 0.14;
  background-image: 
    linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px);
  background-size: 48rpx 48rpx;
}
.pr-hero::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,140,66,.15) 0%, transparent 70%);
  border-radius: 50%;
}
.pr-avatar {
  width: 120rpx; 
  height: 120rpx; 
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  display: flex; 
  align-items: center; 
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.pr-avatar-ico { width: 60rpx; height: 60rpx; opacity: 0.9; }
.pr-name { 
  font-size: 34rpx; 
  font-weight: 800; 
  display: flex; 
  align-items: center;
  position: relative;
  z-index: 1;
}
.pr-member { 
  background: var(--gold); 
  color: #fff; 
  margin-left: 14rpx; 
  display: flex; 
  align-items: center; 
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.pr-tag-ico { width: 28rpx; height: 28rpx; }
.pr-company { 
  font-size: 24rpx; 
  opacity: .85; 
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* Stats */
.pr-stats { 
  display: flex; 
  margin: -24rpx 32rpx 0; 
  padding: 28rpx 0; 
  text-align: center;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 2;
}
.pr-stat { flex: 1; }
.pr-stat + .pr-stat { border-left: 2rpx solid var(--line); }
.pr-stat-num { font-size: 32rpx; font-weight: 800; color: var(--blue); }
.pr-stat-lbl { font-size: 22rpx; color: var(--gray); margin-top: 8rpx; }

/* Menu */
.pr-menu { margin: 24rpx 32rpx 0; padding: 8rpx 28rpx; }
.pr-row { 
  display: flex; 
  align-items: center; 
  gap: 24rpx; 
  padding: 26rpx 0; 
  border-bottom: 2rpx solid var(--line);
  transition: background var(--transition-fast);
}
.pr-row:active { background: var(--bg-secondary); }
.pr-row-last { border-bottom: none; }
.pr-row-ico { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.pr-row-img { width: 36rpx; height: 36rpx; }
.pr-row-t { font-size: 28rpx; flex: 1; color: var(--ink); }
.pr-row-arr { color: var(--gray); font-size: 32rpx; }
.pr-row-note { font-size: 22rpx; color: var(--orange-600); }
.pr-row-primary .pr-row-t { color: var(--blue); font-weight: 700; }
.pr-row-danger .pr-row-t { color: #ef4444; font-weight: 700; }

/* Mascot accents */
.dl-mascot, .about-mascot {
  position: absolute;
  right: 20rpx;
  width: 100rpx;
  height: 100rpx;
  opacity: 0.7;
  pointer-events: none;
  z-index: 0;
}
.dl-mascot { bottom: -10rpx; }
.about-mascot { top: -10rpx; }
.pr-row { position: relative; overflow: hidden; }

/* Footer */
.pr-footer { text-align: center; font-size: 20rpx; color: #94A3B8; margin: 32rpx 40rpx; line-height: 1.6; }

/* Login Modal */
.login-modal { 
  max-height: 85vh; 
  width: 88%;
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
}

/* Brand header */
.login-brand {
  background: linear-gradient(135deg, var(--blue) 0%, var(--blue-600) 100%);
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.login-brand::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,.1) 0%, transparent 70%);
  border-radius: 50%;
}
.login-brand-mascot {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  display: block;
  position: relative;
  z-index: 1;
}
.login-brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  position: relative;
  z-index: 1;
}
.login-brand-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,.8);
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

.login-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: rgba(255,255,255,.7);
  z-index: 2;
}

/* Login sections */
.login-section { padding: 28rpx 32rpx 8rpx; }

/* WeChat login button */
.login-btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,.3);
  transition: all var(--transition-fast);
}
.login-btn-wechat:active { transform: scale(0.98); }
.login-btn-ico { width: 40rpx; height: 40rpx; }
.login-btn-desc {
  text-align: center;
  font-size: 22rpx;
  color: var(--gray);
  margin-top: 12rpx;
}

/* Divider */
.login-divider { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 64rpx; }
.login-divider-line { flex: 1; height: 2rpx; background: var(--line); }
.login-divider-text { font-size: 24rpx; color: var(--gray); }

/* Phone login toggle */
.login-phone-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: var(--blue-50);
  color: var(--blue);
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: 2rpx solid var(--blue-100);
  transition: all var(--transition-fast);
}
.login-phone-toggle:active { background: var(--blue-100); }
.login-btn-ico-sm { width: 36rpx; height: 36rpx; }
.login-toggle-arrow {
  font-size: 36rpx;
  margin-left: 4rpx;
  transition: transform var(--transition-fast);
}
.arrow-rotated { transform: rotate(90deg); }

/* Phone form */
.login-form { padding: 24rpx 0 0; }
.login-input-wrap { 
  display: flex; 
  align-items: center; 
  gap: 16rpx; 
  padding: 24rpx 28rpx; 
  background: var(--bg-secondary); 
  border-radius: 20rpx; 
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: border-color var(--transition-fast);
}
.login-input-wrap:focus-within { border-color: var(--blue-100); }
.login-input-ico { width: 36rpx; height: 36rpx; opacity: 0.5; }
.login-input { flex: 1; font-size: 28rpx; color: var(--ink); }
.login-code-btn { 
  font-size: 24rpx; 
  color: var(--blue); 
  font-weight: 700; 
  padding: 12rpx 24rpx; 
  background: var(--blue-50);
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.login-code-btn.code-btn-disabled { color: var(--gray); background: var(--bg-secondary); }
.login-submit-btn { 
  height: 96rpx; 
  font-size: 30rpx; 
  margin-top: 28rpx; 
  border-radius: 48rpx;
}

/* Privacy note */
.login-privacy {
  text-align: center;
  font-size: 20rpx;
  color: var(--gray-light);
  padding: 24rpx 48rpx 40rpx;
  line-height: 1.6;
}