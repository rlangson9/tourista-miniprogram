/* pages/profile/profile.wxss */

/* Hero */
.pr-hero {
  background: linear-gradient(135deg, var(--blue), #3B5BDB);
  color: #fff;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}
.grid-lines {
  position: absolute;
  inset: 0;
  opacity: 0.14;
  background-image: 
    linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px);
  background-size: 48rpx 48rpx;
}
.pr-hero::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,140,66,.15) 0%, transparent 70%);
  border-radius: 50%;
}
.pr-avatar {
  width: 120rpx; 
  height: 120rpx; 
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  display: flex; 
  align-items: center; 
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.pr-avatar-ico { width: 60rpx; height: 60rpx; opacity: 0.9; }
.pr-name { 
  font-size: 34rpx; 
  font-weight: 800; 
  display: flex; 
  align-items: center;
  position: relative;
  z-index: 1;
}
.pr-member { 
  background: var(--gold); 
  color: #fff; 
  margin-left: 14rpx; 
  display: flex; 
  align-items: center; 
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.pr-tag-ico { width: 28rpx; height: 28rpx; }
.pr-company { 
  font-size: 24rpx; 
  opacity: .85; 
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* Stats */
.pr-stats { 
  display: flex; 
  margin: -24rpx 32rpx 0; 
  padding: 28rpx 0; 
  text-align: center;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 2;
}
.pr-stat { flex: 1; }
.pr-stat + .pr-stat { border-left: 2rpx solid var(--line); }
.pr-stat-num { font-size: 32rpx; font-weight: 800; color: var(--blue); }
.pr-stat-lbl { font-size: 22rpx; color: var(--gray); margin-top: 8rpx; }

/* Menu */
.pr-menu { margin: 24rpx 32rpx 0; padding: 8rpx 28rpx; }
.pr-row { 
  display: flex; 
  align-items: center; 
  gap: 24rpx; 
  padding: 26rpx 0; 
  border-bottom: 2rpx solid var(--line);
  transition: background var(--transition-fast);
}
.pr-row:active { background: var(--bg-secondary); }
.pr-row-last { border-bottom: none; }
.pr-row-ico { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.pr-row-img { width: 36rpx; height: 36rpx; }
.pr-row-t { font-size: 28rpx; flex: 1; color: var(--ink); }
.pr-row-arr { color: var(--gray); font-size: 32rpx; }
.pr-row-note { font-size: 22rpx; color: var(--orange-600); }
.pr-row-primary .pr-row-t { color: var(--blue); font-weight: 700; }
.pr-row-danger .pr-row-t { color: #ef4444; font-weight: 700; }

/* Mascot accents */
.dl-mascot, .about-mascot {
  position: absolute;
  right: 48rpx;
  width: 52rpx;
  height: 52rpx;
  opacity: 0.75;
  pointer-events: none;
  z-index: 0;
}
.dl-mascot { bottom: 4rpx; }
.about-mascot { top: 4rpx; }
.pr-row { position: relative; overflow: visible; }

/* Footer */
.pr-footer { text-align: center; font-size: 20rpx; color: #94A3B8; margin: 32rpx 40rpx; line-height: 1.6; }

/* Login Modal */
.login-modal { 
  max-height: 85vh; 
  width: 88%;
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
}

/* Brand header */
.login-brand {
  background: linear-gradient(135deg, var(--blue) 0%, var(--blue-600) 100%);
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.login-brand::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,.1) 0%, transparent 70%);
  border-radius: 50%;
}
.login-brand-mascot {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  display: block;
  position: relative;
  z-index: 1;
}
.login-brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  position: relative;
  z-index: 1;
}
.login-brand-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,.8);
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

.login-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: rgba(255,255,255,.7);
  z-index: 2;
}

/* Login sections */
.login-section { padding: 28rpx 32rpx 8rpx; }

/* WeChat login button */
.login-btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,.3);
  transition: all var(--transition-fast);
}
.login-btn-wechat:active { transform: scale(0.98); }
.login-btn-ico { width: 40rpx; height: 40rpx; }
.login-btn-desc {
  text-align: center;
  font-size: 22rpx;
  color: var(--gray);
  margin-top: 12rpx;
}

/* Divider */
.login-divider { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 64rpx; }
.login-divider-line { flex: 1; height: 2rpx; background: var(--line); }
.login-divider-text { font-size: 24rpx; color: var(--gray); }

/* Phone login toggle */
.login-phone-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: var(--blue-50);
  color: var(--blue);
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: 2rpx solid var(--blue-100);
  transition: all var(--transition-fast);
}
.login-phone-toggle:active { background: var(--blue-100); }
.login-btn-ico-sm { width: 36rpx; height: 36rpx; }
.login-toggle-arrow {
  font-size: 36rpx;
  margin-left: 4rpx;
  transition: transform var(--transition-fast);
}
.arrow-rotated { transform: rotate(90deg); }

/* Phone form */
.login-form { padding: 24rpx 0 0; }
.login-input-wrap { 
  display: flex; 
  align-items: center; 
  gap: 16rpx; 
  padding: 24rpx 28rpx; 
  background: var(--bg-secondary); 
  border-radius: 20rpx; 
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: border-color var(--transition-fast);
}
.login-input-wrap:focus-within { border-color: var(--blue-100); }
.login-input-ico { width: 36rpx; height: 36rpx; opacity: 0.5; }
.login-input { flex: 1; font-size: 28rpx; color: var(--ink); }
.login-code-btn { 
  font-size: 24rpx; 
  color: var(--blue); 
  font-weight: 700; 
  padding: 12rpx 24rpx; 
  background: var(--blue-50);
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.login-code-btn.code-btn-disabled { color: var(--gray); background: var(--bg-secondary); }
.login-submit-btn { 
  height: 96rpx; 
  font-size: 30rpx; 
  margin-top: 28rpx; 
  border-radius: 48rpx;
}

/* Privacy note */
.login-privacy {
  text-align: center;
  font-size: 20rpx;
  color: var(--gray-light);
  padding: 24rpx 48rpx 40rpx;
  line-height: 1.6;
}

/* ==========================================================================
   About Modal – Company info, Team, Contacts
   ========================================================================== */

/* Overrides for about mask (darker) */
.about-modal { background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4rpx); }

.about-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  top: 8%;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -20rpx 60rpx rgba(15,23,42,0.18);
  animation: aboutSlideUp 240ms cubic-bezier(.2,.8,.2,1);
}
@keyframes aboutSlideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

/* Close button */
.about-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  backdrop-filter: blur(6rpx);
}
.about-close:active { transform: scale(0.92); }
.about-close-ico { width: 32rpx; height: 32rpx; color: #fff; }

/* Hero */
.about-hero {
  position: relative;
  padding: 80rpx 40rpx 56rpx;
  background: linear-gradient(145deg, var(--blue) 0%, var(--blue-600) 55%, var(--terra) 135%);
  color: #fff;
  overflow: hidden;
  flex-shrink: 0;
}
.about-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 85% -10%, rgba(255,140,66,0.35), transparent 55%),
    radial-gradient(circle at -5% 110%, rgba(120,255,200,0.15), transparent 50%);
}
.about-hero-grid {
  position: absolute;
  inset: 0;
  opacity: 0.12;
  background-image:
    linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px);
  background-size: 44rpx 44rpx;
}
.about-hero-mascot {
  position: absolute;
  right: 24rpx;
  top: 36rpx;
  width: 110rpx;
  height: 110rpx;
  opacity: 0.85;
  transform: rotate(-10deg);
  filter: drop-shadow(0 8rpx 18rpx rgba(0,0,0,0.22));
  z-index: 2;
}
.about-hero-brand {
  font-size: 22rpx;
  letter-spacing: 10rpx;
  font-weight: 800;
  opacity: 0.85;
  position: relative;
  z-index: 1;
}
.about-hero-title {
  font-size: 50rpx;
  font-weight: 800;
  margin-top: 14rpx;
  position: relative;
  z-index: 1;
}
.about-hero-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  opacity: 0.92;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

/* Scroll body */
.about-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0 64rpx;
}

/* Sections */
.about-section {
  padding: 36rpx 32rpx 0;
}
.about-p {
  font-size: 28rpx;
  line-height: 1.78;
  color: var(--ink);
}
.about-p-mute {
  color: var(--gray);
  margin-top: 16rpx;
  font-size: 26rpx;
}

/* Section header */
.about-sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--line);
}
.about-sec-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--blue-50) 0%, var(--gold-50) 100%);
  color: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
}
.about-sec-img { width: 32rpx; height: 32rpx; }
.about-sec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

/* Mission card */
.about-mission {
  margin: 32rpx 32rpx 0;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff8ef 0%, #eef4ff 100%);
  border: 2rpx solid rgba(255,140,66,0.18);
  position: relative;
  overflow: hidden;
  text-align: center;
}
.about-mission::after {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(46,94,31,0.08) 0%, transparent 70%);
  pointer-events: none;
}
.about-mission-ico {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--gold) 0%, var(--terra) 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255,140,66,0.35);
}
.about-mission-img { width: 48rpx; height: 48rpx; }
.about-mission-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.about-mission-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #2E5E1F;
  font-weight: 600;
}

/* ================= TEAM ================= */
.team-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.team-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}
.team-card:active { transform: translateY(2rpx); }
.team-photo-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: linear-gradient(135deg, var(--blue) 0%, var(--gold) 100%);
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(46,94,31,0.2);
}
.team-photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--bg-secondary);
  overflow: hidden;
}
.team-initial {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue-50) 0%, var(--gold-50) 100%);
  color: var(--blue);
  font-size: 64rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.team-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}
.team-role {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--blue-50);
  color: var(--blue);
  letter-spacing: 0.4rpx;
}
.team-bio {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.72;
  color: var(--gray);
  padding: 0 10rpx;
}

/* ================= CONTACT CARD ================= */
.contact-card {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--line);
}
.contact-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
  transition: background var(--transition-fast);
}
.contact-row:active { background: var(--bg-secondary); }
.contact-row-last { border-bottom: none; }

.contact-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--blue-50) 0%, #fff 100%);
  color: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.contact-img { width: 36rpx; height: 36rpx; }

.contact-info { flex: 1; min-width: 0; }
.contact-lbl {
  font-size: 22rpx;
  color: var(--gray);
  font-weight: 600;
  letter-spacing: 0.4rpx;
  text-transform: uppercase;
}
.contact-val {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.45;
  word-break: break-word;
}

.contact-act {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-secondary);
  color: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact-act:active { background: var(--blue-50); }
.contact-act-img { width: 28rpx; height: 28rpx; }

/* Legal footer */
.about-legal {
  margin: 48rpx 32rpx 0;
  padding: 32rpx 28rpx;
  text-align: center;
  border-top: 2rpx dashed var(--line);
  color: var(--gray-light);
}
.about-legal-line {
  font-size: 23rpx;
  line-height: 1.8;
  letter-spacing: 0.3rpx;
}
.about-copy {
  margin-top: 14rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

/* Modal mask base (reuse pattern from login, ensure consistent) */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}