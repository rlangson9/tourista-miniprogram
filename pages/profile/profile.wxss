/* pages/profile/profile.wxss */
.pr-hero {
  background: linear-gradient(150deg, #1A2233, #3A2418);
  color: #fff;
  padding: 30rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.pr-avatar {
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.pr-avatar-ico { width: 52rpx; height: 52rpx; opacity: 0.9; }
.pr-name { font-size: 30rpx; font-weight: 700; display: flex; align-items: center; }
.pr-member { background: var(--gold); color: #fff; margin-left: 12rpx; display: flex; align-items: center; gap: 4rpx; }
.pr-tag-ico { width: 24rpx; height: 24rpx; }
.pr-company { font-size: 20rpx; opacity: .7; margin-top: 4rpx; }

.pr-stats { display: flex; margin: 20rpx 28rpx 0; padding: 22rpx 0; text-align: center; }
.pr-stat { flex: 1; }
.pr-stat + .pr-stat { border-left: 1rpx solid var(--line); }
.pr-stat-num { font-size: 28rpx; font-weight: 700; }
.pr-stat-lbl { font-size: 19rpx; color: var(--grey); margin-top: 4rpx; }

.pr-menu { margin: 20rpx 28rpx 0; padding: 4rpx 24rpx; }
.pr-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.pr-row-last { border-bottom: none; }
.pr-row-ico { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.pr-row-img { width: 32rpx; height: 32rpx; }
.pr-row-t { font-size: 24rpx; flex: 1; }
.pr-row-arr { color: var(--grey); font-size: 26rpx; }
.pr-row-note { font-size: 19rpx; color: var(--terra); }
.pr-row-primary .pr-row-t { color: var(--primary); font-weight: 600; }
.pr-row-danger .pr-row-t { color: #FF6B35; font-weight: 600; }

.pr-footer { text-align: center; font-size: 18rpx; color: #B5BCCB; margin: 28rpx 40rpx; line-height: 1.6; }

/* Login Modal */
.login-modal { max-height: 70vh; width: 85%; }
.login-options { padding: 32rpx 24rpx; }
.login-option { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 24rpx; background: rgba(0,168,150,0.05); border-radius: 16rpx; border: 1rpx solid rgba(0,168,150,0.2); }
.login-option-ico { width: 56rpx; height: 56rpx; }
.login-option-text { font-size: 28rpx; font-weight: 600; color: var(--primary); }

.login-divider { display: flex; align-items: center; gap: 20rpx; margin: 24rpx 0; }
.login-divider-line { flex: 1; height: 1rpx; background: var(--line); }
.login-divider-text { font-size: 22rpx; color: var(--grey); }

.login-form { padding: 0 24rpx 32rpx; }
.login-input-wrap { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 20rpx; background: var(--bg); border-radius: 12rpx; margin-bottom: 20rpx; }
.login-input-ico { width: 36rpx; height: 36rpx; opacity: 0.6; }
.login-input { flex: 1; font-size: 26rpx; }
.login-code-btn { font-size: 24rpx; color: var(--primary); font-weight: 600; padding: 8rpx 16rpx; }
.login-submit-btn { padding: 20rpx 0; font-size: 28rpx; margin-top: 24rpx; }
