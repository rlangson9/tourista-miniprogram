/* pages/orders/orders.wxss */

/* Order tabs */
.ordertab {
  display: flex;
  border-bottom: 2rpx solid var(--line);
  background: #fff;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}
.ot {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx 0;
  color: var(--gray);
  position: relative;
}
.ot.active { color: var(--blue); }
.ot.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 68rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--blue);
}

/* Order cards */
.order, .appl { margin: 24rpx 32rpx 0; }
.order-head { 
  padding: 24rpx; 
  border-bottom: 2rpx solid var(--line); 
  display: flex; 
  align-items: flex-start; 
  justify-content: space-between;
}
.order-title-wrap { flex: 1; }
.order-title { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.order-company { display: flex; align-items: center; gap: 14rpx; margin-top: 10rpx; }
.company-badge { font-size: 20rpx; color: var(--blue); background: var(--blue-50); padding: 6rpx 14rpx; border-radius: 10rpx; }
.traveller-count { font-size: 20rpx; color: var(--gray); }
.order-contact { color: var(--blue); font-weight: 600; }
.order-info { padding: 20rpx 24rpx; font-size: 22rpx; color: var(--gray); line-height: 1.8; white-space: pre-line; }
.order-actions { padding: 0 24rpx 24rpx; display: flex; gap: 16rpx; justify-content: flex-end; }
.oa-btn { padding: 14rpx 28rpx; font-size: 24rpx; }

/* Checklist */
.checklist { margin: 24rpx 32rpx; padding: 8rpx 28rpx; }
.ck-row { display: flex; align-items: center; padding: 18rpx 0; }
.ck-border { border-bottom: 2rpx solid var(--line); }
.ck-mark { margin-right: 18rpx; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; }
.ck-img { width: 28rpx; height: 28rpx; }
.ck-done .ck-img { opacity: 1; }
.ck-done { color: var(--green); }
.ck-label { font-size: 26rpx; flex: 1; color: var(--ink); }
.ck-status { font-size: 22rpx; color: var(--orange-600); }
.ck-status-done { color: var(--green); }

/* Group */
.group { 
  margin: 24rpx 32rpx; 
  padding: 28rpx; 
  display: flex; 
  align-items: center; 
  gap: 24rpx; 
  border: 2rpx solid rgba(16,185,129,.2); 
  background: linear-gradient(135deg, rgba(16,185,129,.05) 0%, #fff 50%);
}
.group-ico { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.group-img { width: 44rpx; height: 44rpx; }
.group-t { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.group-d { font-size: 22rpx; color: var(--gray); margin-top: 6rpx; }
.group-btn { padding: 14rpx 28rpx; font-size: 24rpx; }

/* Application rows */
.appl-row { display: flex; padding: 18rpx 24rpx; }
.appl-row + .appl-row { border-top: 2rpx solid var(--line); }
.appl-k { font-size: 24rpx; color: var(--gray); width: 160rpx; flex-shrink: 0; }
.appl-v { font-size: 24rpx; flex: 1; color: var(--ink); }

/* Empty state */
.empty { margin: 48rpx 32rpx; padding: 60rpx 40rpx; text-align: center; }
.empty-ico { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto; background: var(--bg-secondary); border-radius: 50%; }
.empty-img { width: 80rpx; height: 80rpx; opacity: 0.5; }
.empty-t { font-size: 32rpx; font-weight: 700; margin-top: 24rpx; color: var(--ink); }
.empty-d { font-size: 24rpx; color: var(--gray); line-height: 1.7; margin-top: 14rpx; }
.empty-btn { padding: 24rpx 0; margin-top: 32rpx; }

/* QR Code Modal */
.qr-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15,23,42,.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn var(--transition-fast);
}

.qr-modal-content {
  width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  animation: scaleIn var(--transition-normal);
}

.qr-modal-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid var(--line);
}

.qr-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.qr-modal-close {
  font-size: 48rpx;
  color: var(--gray);
  line-height: 1;
  padding: 8rpx;
}

.qr-modal-body {
  padding: 32rpx;
  text-align: center;
}

.qr-modal-trip {
  font-size: 26rpx;
  color: var(--gray);
  display: block;
  margin-bottom: 28rpx;
}

.qr-code-wrap {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
  background: #fff;
  border: 4rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.08);
}

.qr-code-img {
  width: 100%;
  height: 100%;
}

.qr-modal-tip {
  font-size: 22rpx;
  color: var(--gray);
  display: block;
  margin-top: 24rpx;
}

.qr-modal-footer {
  padding: 24rpx 32rpx 36rpx;
}

.qr-modal-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 30rpx;
}