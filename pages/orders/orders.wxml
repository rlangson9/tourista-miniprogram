<!-- pages/orders/orders.wxml -->
<view class="page-wrap">

  <view class="ordertab">
    <view class="ot {{tab===0?'active':''}}" bindtap="switchTab" data-i="0">{{i18n.trips}}</view>
    <view class="ot {{tab===1?'active':''}}" bindtap="switchTab" data-i="1">{{i18n.applications}}</view>
  </view>

  <!-- Trip orders -->
  <block wx:if="{{tab===0}}">
    <block wx:if="{{tripOrders.length > 0}}">
      <view class="card order" wx:for="{{tripOrders}}" wx:key="id">
        <view class="order-head">
          <view class="order-title-wrap">
            <text class="order-title">{{item.title}}</text>
            <view wx:if="{{item.bookingType === 'company'}}" class="order-company">
              <text class="company-badge">{{item.companyName}}</text>
              <text class="traveller-count">{{item.travellerCount}}{{i18n.personUnit || '人'}}</text>
            </view>
          </view>
          <text class="tag {{item.status==='已确认' || item.status==='Confirmed' ? 'tag-success' : 'tag-accent'}}">{{item.status}}</text>
        </view>
        <view class="order-info">
          <text wx:if="{{item.bookingType === 'company' && item.contactPerson}}" class="order-contact">{{i18n.contactPerson || '联系人'}}：{{item.contactPerson}} · </text>
          {{i18n.departure}}：{{item.depart}} · {{item.city}}{{'\n'}}{{i18n.depositPaid}} ¥{{item.depositText}} · {{i18n.balance}} ¥{{item.balanceText}}（{{item.balanceDue}}{{i18n.before}}）
        </view>
        <view class="order-actions">
          <view class="btn btn-ghost oa-btn" bindtap="viewItinerary">{{i18n.itinerary}}</view>
          <view class="btn btn-ghost oa-btn" bindtap="viewVisaMaterials">{{i18n.visaMaterials}}</view>
          <view class="btn btn-primary oa-btn" bindtap="payBalance" data-id="{{item.id}}">{{i18n.payBalance}}</view>
        </view>
      </view>

      <!-- Prep checklist (first order) -->
      <view class="sec-title">{{i18n.prepChecklist}}</view>
      <view class="card checklist">
        <view class="ck-row {{index < firstChecklist.length-1 ? 'ck-border' : ''}}"
              wx:for="{{firstChecklist}}" wx:key="label">
          <text class="ck-mark {{item.done?'ck-done':''}}"><image class="ck-img" src="{{item.done?'/images/icon-check.svg':'/images/icon-circle.svg'}}" mode="aspectFit"/></text>
          <text class="ck-label">{{item.label}}</text>
          <text class="ck-status {{item.done?'ck-status-done':''}}">
            {{item.done ? i18n.completed : (item.info ? i18n.view + ' ›' : i18n.upload + ' ›')}}
          </text>
        </view>
      </view>

      <!-- Group entry -->
      <view class="card group">
        <image class="orders-mascot" src="/images/mascot-bao.png" mode="aspectFit"/>
        <text class="group-ico"><image class="group-img" src="/images/icon-chat.svg" mode="aspectFit"/></text>
        <view class="flex1">
          <view class="group-t">{{i18n.groupChat}}</view>
          <view class="group-d">{{i18n.groupChatDesc}}</view>
        </view>
        <view class="btn btn-green group-btn" bindtap="joinGroup">{{i18n.joinGroup}}</view>
      </view>
    </block>

    <view wx:else class="empty card">
      <view class="empty-ico"><image class="empty-img" src="/images/icon-airplane.svg" mode="aspectFit"/></view>
      <view class="empty-t">{{i18n.noTrips}}</view>
      <view class="empty-d">{{i18n.noTripsDesc}}</view>
      <view class="btn btn-primary empty-btn" bindtap="goTrips">{{i18n.viewTrips}}</view>
    </view>
  </block>

  <!-- Partner applications -->
  <block wx:if="{{tab===1}}">
    <block wx:if="{{applications.length > 0}}">
      <view class="card appl" wx:for="{{applications}}" wx:key="id">
        <view class="order-head">
          <text class="order-title">{{item.company}}</text>
          <text class="tag {{item.status==='顾问已对接' || item.status==='Advisor Connected' ? 'tag-success' : 'tag-accent'}}">{{item.status}}</text>
        </view>
        <view class="appl-row"><text class="appl-k">{{i18n.productCategory}}</text><text class="appl-v">{{item.categoriesText}}</text></view>
        <view class="appl-row"><text class="appl-k">{{i18n.cooperationMode}}</text><text class="appl-v">{{item.modesText}}</text></view>
        <view class="appl-row"><text class="appl-k">{{i18n.targetMarket}}</text><text class="appl-v">{{item.marketsText}}</text></view>
        <view class="appl-row"><text class="appl-k">{{i18n.submitTime}}</text><text class="appl-v">{{item.createdAt}}</text></view>
      </view>
    </block>
    <view wx:else class="empty card">
      <view class="empty-ico"><image class="empty-img" src="/images/icon-handshake.svg" mode="aspectFit"/></view>
      <view class="empty-t">{{i18n.noApplications}}</view>
      <view class="empty-d">{{i18n.noApplicationsDesc}}</view>
      <view class="btn btn-primary empty-btn" bindtap="goBusiness">{{i18n.learnCooperation}}</view>
    </view>
  </block>

  <!-- QR Code Modal -->
  <view wx:if="{{showQRModal}}" class="qr-modal" bindtap="closeQRModal">
    <view class="qr-modal-content" catchtap="">
      <view class="qr-modal-header">
        <text class="qr-modal-title">{{i18n.groupChat}}</text>
        <view class="qr-modal-close" bindtap="closeQRModal">×</view>
      </view>
      <view class="qr-modal-body">
        <text class="qr-modal-trip">{{groupTripTitle}}</text>
        <view class="qr-code-wrap">
          <image class="qr-code-img" src="{{qrCodeUrl}}" mode="aspectFit" bindlongpress="saveQRCode"/>
        </view>
        <text class="qr-modal-tip">{{i18n.longPressSave || 'Long press to save to album'}}</text>
      </view>
      <view class="qr-modal-footer">
        <view class="btn btn-primary qr-modal-btn" bindtap="saveQRCode">{{i18n.saveImage || 'Save Image'}}</view>
      </view>
    </view>
  </view>

</view>
